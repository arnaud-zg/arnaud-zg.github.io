{
  "name": "portfolio-events",
  "main": "src/main.ts",
  "compatibility_date": "2026-11-01",
  // Request logs would hold addresses: none are kept.
  "observability": { "enabled": false },
  "vars": { "ALLOWED_ORIGIN": "https://arnaud-zg.github.io" },
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "portfolio_events" }],
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "4118", "simple": { "limit": 120, "period": 60 } }]
}
