---
// Pull requests of one repository, each with a dot for its status (filled: merged, hollow: in
// review). An issue reported first folds into the pull request that closes it.
import { external } from "../links";
import type { ActivityStatus, ActivityThread } from "./Activity.astro";
interface Props { items: ActivityThread[]; labels: Record<ActivityStatus, string> & { reported: (n: string) => string } }
const { items, labels } = Astro.props;
---
<ul class="act-threads">
  {items.map((t) => (
    <li class={`act-thread is-${t.status}`}>
      <span class="act-dot" role="img" aria-label={labels[t.status]} title={labels[t.status]}></span>
      <span class="act-what">
        <a class="act-title" href={t.href} {...external}>{t.title}</a>
        {t.reported?.map((i) => <a class="act-note" href={i.href} {...external}>{labels.reported(i.number)}</a>)}
      </span>
    </li>
  ))}
</ul>

<style is:global>
.act-threads {
  display: grid;
  gap: 8px;
}
.act-thread {
  display: grid;
  grid-template-columns: 8px minmax(0, 1fr);
  gap: 0 12px;
  align-items: baseline;
}
.act-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: 1.5px solid var(--ink-lo);
}
.is-merged .act-dot {
  border-color: var(--added);
  background: var(--added);
}
.act-what {
  display: grid;
  gap: 2px;
}
.act-title {
  font-size: var(--fs-small);
  line-height: 1.45;
  overflow-wrap: break-word;
}
.is-review .act-title {
  color: var(--ink-lo);
}
.act-note {
  font: 400 var(--fs-label)/1.6 var(--mono);
  letter-spacing: 0.06em;
  color: var(--ink-lo);
}
.act-title:hover,
.act-note:hover {
  color: var(--accent);
}
@media (prefers-reduced-motion: no-preference) {
.act-title,
.act-note {
    transition: color 300ms var(--ease-out);
  }
}
</style>
