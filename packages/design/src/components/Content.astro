---
// Everything below the hero: the page's sky, its stars at night, its pointer light.
import Stars from "./Stars.astro";
---
<div class="content">
  <div class="night-sky" data-loop><Stars class="night-stars" seed={12} count={60} /></div>
  <div class="lantern" aria-hidden="true"></div>
  <slot />
</div>

<style is:global>
.content {
  position: relative;
  isolation: isolate;
  clip-path: inset(0);
  background: linear-gradient(var(--bg), var(--bg-deep));
  padding-bottom: var(--section);
}
.night-sky {
  position: absolute;
  inset: 0;
  z-index: -1;
  overflow: hidden;
  opacity: calc(var(--night) * 0.45);
  transition: opacity 900ms ease;
}
.night-stars {
  width: 100%;
  height: 100%;
}
.lantern {
  position: fixed;
  left: 0;
  top: 0;
  z-index: -1;
  width: 640px;
  height: 640px;
  margin: -320px 0 0 -320px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201, 155, 255, 0.07), transparent 65%);
  opacity: 0;
  pointer-events: none;
  transition:
    opacity 600ms var(--ease-out),
    translate 900ms var(--ease-out);
}
[data-theme="dark"] .lantern.is-on {
  opacity: 1;
}
[data-theme="light"] .lantern {
  background: radial-gradient(
    circle,
    rgba(107, 63, 196, 0.09),
    rgba(107, 63, 196, 0.03) 40%,
    transparent 65%
  );
}
[data-theme="light"] .lantern.is-on {
  opacity: 1;
}
.masthead[data-solid] ~ main .content {
  min-height: 100svh;
}
@media (max-width: 640px) {
.lantern {
    display: none;
  }
}
</style>
