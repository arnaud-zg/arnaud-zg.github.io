---
// A quiet action. With `opens`, it opens the Dialog of that id.
import Icon from "./Icon.astro";
interface Props { opens?: string }
const { opens } = Astro.props;
---
<button class="pill" type="button" data-open-dialog={opens} aria-haspopup={opens ? "dialog" : undefined}><slot /> <Icon name="arrow" size={16} /></button>
