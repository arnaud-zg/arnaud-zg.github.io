---
// A quiet action. With `opens`, it opens the Dialog of that id. `look`: `arrow` leads somewhere,
// `plain` is an answer or a choice (`aria-pressed`), `quiet` is plain small text.
import Icon from "./Icon.astro";
import type { Choice } from "../variants";
import { pillVariants } from "./Pill.variants";
interface Props extends Partial<Choice<typeof pillVariants.axes>> { opens?: string; "aria-pressed"?: "true" | "false"; [data: `data-${string}`]: string | boolean | undefined }
const { opens, look = pillVariants.defaults.look, ...rest } = Astro.props;
---
<button class={look === "quiet" ? "quiet" : "pill"} type="button" {...pillVariants.attrs({ look })} data-open-dialog={opens} aria-haspopup={opens ? "dialog" : undefined} {...rest}><slot />{look === "arrow" && <> <Icon name="arrow" size={16} /></>}</button>

<style is:global>
.pill {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 18px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: none;
  color: var(--ink);
  font: inherit;
  font-size: var(--fs-small);
  cursor: pointer;
  transition:
    border-color 300ms var(--ease-out),
    color 300ms var(--ease-out);
}
.pill:hover {
  border-color: var(--accent);
  color: var(--accent);
}
.pill:hover .arrow {
  translate: 4px 0;
}
.pill[aria-pressed="true"] {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
}
.quiet {
  padding: 10px 12px;
  border: 0;
  background: none;
  color: var(--ink-lo);
  font: inherit;
  font-size: var(--fs-small);
  cursor: pointer;
  transition: color 300ms var(--ease-out);
}
.quiet:hover {
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 0.25em;
}
</style>
