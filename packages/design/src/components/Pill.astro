---
// A quiet action. With `opens`, it opens the Dialog of that id. `plain` drops the arrow, for an
// answer or a choice (`aria-pressed`).
import Icon from "./Icon.astro";
interface Props { opens?: string; plain?: boolean; "aria-pressed"?: "true" | "false"; [data: `data-${string}`]: string | boolean | undefined }
const { opens, plain = false, ...rest } = Astro.props;
---
<button class="pill" type="button" data-open-dialog={opens} aria-haspopup={opens ? "dialog" : undefined} {...rest}><slot />{!plain && <> <Icon name="arrow" size={16} /></>}</button>
