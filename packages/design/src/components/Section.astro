---
// A band of the page, as wide as the content. `space="tight"` sits closer to what is above it.
import type { Choice } from "../variants";
import { sectionVariants } from "./Section.variants";
interface Props extends Partial<Choice<typeof sectionVariants.axes>> { id?: string; label?: string; labelledby?: string; as?: "section" | "article" }
const { id, label, labelledby, as: Tag = "section", space } = Astro.props;
---
<Tag id={id} class="section" {...sectionVariants.attrs({ space })} aria-label={label} aria-labelledby={labelledby}><slot /></Tag>

<style is:global>
.section {
  max-width: 1240px;
  margin: 0 auto;
  padding: var(--section) var(--edge) 0;
}
.section[data-space="tight"] {
  padding-top: clamp(48px, 6vw, 80px);
}
</style>
