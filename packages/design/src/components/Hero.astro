---
// The photo at the top of a page. `full` fills the screen (home); `banner` is the short one
// sub-sites open on. The browser morphs one into the other during navigation. `role` and the
// slot (the profiles) sit under the tagline.
import Rich from "./Rich.astro";
import type { SiteInfo } from "../site";
interface Props { site: SiteInfo; title: string; size?: "full" | "banner"; animate?: boolean; tagline?: string; role?: { text: string; company: string }; next?: string; transitionName?: string; id?: string }
const { site, title, size = "banner", animate = size === "full", tagline, role, next, transitionName, id = "name" } = Astro.props;
const { photo } = site;
const birds = [[0, 20, 1], [18, 10, 0.8], [30, 26, 0.9], [46, 14, 0.7], [62, 24, 0.85], [78, 8, 0.6]];
import "./parts/title.css";
---
<section class:list={["hero", size === "banner" && "hero--banner"]} aria-labelledby={id}>
  <div class="scene" aria-hidden="true">
    <picture>
      <source type="image/avif" srcset={photo.srcset} sizes="100vw" />
      <img src={photo.src} alt="" width={photo.width} height={photo.height} fetchpriority="high" />
    </picture>
  </div>
  <div class="sky-life" aria-hidden="true" data-loop>
    {[0, 1].map((f) => (
      <svg class="flock" style={`--f:${f}`} viewBox="0 0 120 50" width="120" height="50">
        {birds.map(([x, y, sc], b) => (
          <g transform={`translate(${x} ${y}) scale(${sc})`}><path class="bird" style={`--b:${b}`} d="M0 6 Q5 0 10 6 Q15 0 20 6" /></g>
        ))}
      </svg>
    ))}
  </div>
  <div class="hero-copy">
    {animate ? (
      <h1 id={id} aria-label={title}>
        {title.split(" ").map((word, w) => (
          <span class="word" aria-hidden="true">{[...word].map((ch, i) => <span class="ch" style={`--i:${w * 6 + i}`}>{ch}</span>)}</span>
        ))}
      </h1>
    ) : <h1 id={id}><span class="hero-title" style={transitionName && `view-transition-name:${transitionName}`}>{title}</span></h1>}
    {tagline && <p class="tagline"><Rich text={tagline} /></p>}
    {role && <p class="role">{role.text} <strong>{role.company}</strong></p>}
    <slot />
  </div>
  <p class="credit">Photo: <a href={photo.credit.href} target="_blank" rel="noopener noreferrer">{photo.credit.author}</a> on {photo.credit.source}</p>
  {next && <a class="scroll-cue" href={next} aria-label="Scroll to the content"><span></span></a>}
</section>

<style is:global>
.hero {
  position: relative;
  height: 100svh;
  min-height: 640px;
  max-height: 1100px;
  overflow: hidden;
  isolation: isolate;
  background: #0b2a66;
  color: var(--on-photo);
}
.scene {
  position: absolute;
  inset: 0;
  z-index: -3;
}
.scene img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.scene img {
  object-position: 50% 70%;
}
.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  background: linear-gradient(
    90deg,
    rgba(6, 22, 56, 0.62),
    rgba(6, 22, 56, 0.5) 24%,
    rgba(6, 22, 56, 0.28) 38%,
    transparent 56%
  );
  pointer-events: none;
}
.hero::after {
  content: "";
  position: absolute;
  inset: auto 0 0 0;
  height: 16%;
  z-index: -1;
  background: linear-gradient(transparent, var(--bg));
}
.hero-copy {
  position: absolute;
  left: var(--edge);
  top: clamp(104px, 15vh, 170px);
  z-index: 2;
  display: grid;
  gap: 20px;
  max-width: min(44vw, 620px);
}
.hero h1 {
  display: grid;
  font-weight: 200;
  font-size: clamp(3rem, 7.2vw, 7rem);
  line-height: 0.98;
  letter-spacing: 0.1em;
}
.hero-copy :is(.role, .tagline) {
  text-shadow:
    0 1px 14px rgba(6, 16, 40, 0.75),
    0 1px 3px rgba(6, 16, 40, 0.5);
}
.word {
  display: block;
  white-space: nowrap;
}
.ch {
  display: inline-block;
}
.role {
  font-size: clamp(1rem, 1.3vw, 1.15rem);
  letter-spacing: 0.12em;
  color: var(--on-photo);
}
.role strong {
  color: var(--on-photo-accent);
  font-weight: 600;
}
.tagline {
  max-width: 30ch;
  font-size: clamp(1.1rem, 1.6vw, 1.4rem);
  font-weight: 300;
  line-height: 1.45;
  letter-spacing: 0.01em;
  color: var(--on-photo);
  text-wrap: balance;
}
.credit {
  position: absolute;
  right: var(--edge);
  bottom: 22px;
  z-index: 3;
  font: 400 0.68rem/1 var(--mono);
  letter-spacing: 0.06em;
  color: rgba(244, 246, 255, 0.6);
}
.credit a {
  text-decoration: underline;
  text-underline-offset: 0.2em;
  text-decoration-color: rgba(236, 238, 255, 0.3);
}
.credit a:hover {
  color: var(--ink);
}
.scroll-cue {
  position: absolute;
  z-index: 3;
  left: 50%;
  bottom: 22px;
  translate: -50% 0;
  width: 22px;
  height: 36px;
  border: 1px solid rgba(244, 246, 255, 0.4);
  border-radius: 12px;
}
.scroll-cue::after {
  content: "";
  position: absolute;
  inset: -5px -12px;
}
.scroll-cue span {
  position: absolute;
  left: 50%;
  top: 7px;
  width: 2px;
  height: 7px;
  margin-left: -1px;
  border-radius: 1px;
  background: var(--on-photo);
}
.sky-life {
  position: absolute;
  inset: 0 0 45% 0;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}
.flock {
  position: absolute;
  top: calc(14% + var(--f) * 13%);
  left: -140px;
  width: calc(120px - var(--f) * 34px);
  height: auto;
  opacity: 0;
  transition: opacity 1s ease;
}
.bird {
  fill: none;
  stroke: rgba(14, 24, 50, 0.75);
  stroke-width: 2.2;
  stroke-linecap: round;
  transform-box: fill-box;
  transform-origin: center;
}
.hero--banner {
  height: clamp(380px, 52svh, 520px);
  min-height: 0;
}
.hero--banner .scene img {
  object-position: 50% 50%;
}
.hero--banner::before {
  background: linear-gradient(
    90deg,
    rgba(6, 22, 56, 0.6),
    rgba(6, 22, 56, 0.36) 36%,
    transparent 72%
  );
}
.hero--banner .hero-copy {
  top: auto;
  bottom: clamp(64px, 10svh, 96px);
  gap: 14px;
  max-width: min(620px, calc(100vw - 2 * var(--edge)));
}
.hero--banner h1 {
  font-size: clamp(2.2rem, 5vw, 4rem);
  line-height: 1.1;
  letter-spacing: 0.04em;
  overflow-wrap: anywhere;
}
.hero--banner .tagline {
  max-width: 44ch;
  font-size: clamp(1rem, 1.4vw, 1.2rem);
}
[data-theme="light"] .credit {
  color: var(--ink-lo);
}
[data-theme="light"] .credit a:hover {
  color: var(--ink);
}
[data-theme="light"] .scroll-cue {
  border-color: var(--line);
}
[data-theme="light"] .scroll-cue span {
  background: var(--ink);
}
@media (prefers-reduced-motion: no-preference) {
.scene img {
    animation: arrive-city 2.4s var(--ease-out) both;
  }
.ch {
    animation: ink-in 900ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 50ms + 500ms);
  }
.tagline,
.role {
    animation: settle 900ms var(--ease-out) both;
  }
.tagline {
    animation-delay: 1000ms;
  }
.role {
    animation-delay: 1150ms;
  }
.scroll-cue span {
    animation: cue 1.8s var(--ease-out) infinite;
  }
.flock {
    opacity: 1;
    animation: fly calc(26s + var(--f) * 9s) linear infinite;
    animation-delay: calc(var(--f) * -11s);
  }
.bird {
    animation: flap calc(0.5s + var(--b) * 0.07s) ease-in-out infinite alternate;
  }
.is-offscreen .flock,
.is-offscreen .bird {
    animation-play-state: paused;
  }
@supports (animation-timeline: view()) {
.scene {
      animation: sink linear both;
      animation-timeline: scroll(root);
      animation-range: 0 100svh;
    }
.hero-copy {
      animation: lift linear both;
      animation-timeline: scroll(root);
      animation-range: 0 80svh;
    }
}
.hero {
    view-transition-name: hero;
  }
.arrived .scene img,
.arrived .ch,
.arrived .tagline,
.arrived .role {
    animation: none;
  }
@keyframes arrive-city {
    from {
      scale: 1.08;
      filter: blur(6px) brightness(0.6);
    }
  }
@keyframes ink-in {
    from {
      opacity: 0;
      translate: 0 0.3em;
      filter: blur(6px);
    }
  }
@keyframes cue {
    0% {
      opacity: 0;
      translate: 0 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      translate: 0 10px;
    }
  }
@keyframes fly {
    from {
      translate: 0 0;
    }
    50% {
      translate: 55vw -26px;
    }
    to {
      translate: calc(100vw + 280px) 8px;
    }
  }
@keyframes flap {
    to {
      scale: 1 0.35;
    }
  }
@supports (animation-timeline: view()) {
@keyframes sink {
      to {
        translate: 0 12%;
      }
    }
@keyframes lift {
      to {
        opacity: 0;
        translate: 0 -10vh;
      }
    }
}
}
@media (max-width: 640px) {
.scene img {
    object-position: 47% 50%;
  }
.hero-copy {
    top: auto;
    bottom: 74px;
    translate: none;
    max-width: none;
    right: var(--edge);
  }
.hero::after {
    height: 58%;
    background: linear-gradient(
      transparent,
      rgba(6, 10, 24, 0.72) 40%,
      rgba(6, 10, 24, 0.88) 92%,
      var(--bg)
    );
  }
.hero h1 {
    font-size: clamp(2.8rem, 15vw, 4rem);
  }
.credit {
    right: auto;
    left: var(--edge);
    bottom: 22px;
  }
.scroll-cue {
    display: none;
  }
.hero--banner::before {
    background: rgba(6, 22, 56, 0.36);
  }
.hero--banner::after {
    height: 16%;
    background: linear-gradient(transparent, var(--bg));
  }
.hero--banner h1 {
    font-size: clamp(2rem, 9vw, 2.8rem);
  }
.hero--banner .credit {
    display: none;
  }
[data-theme] .hero:not(.hero--banner) .credit {
    bottom: 40px;
    color: var(--on-photo-lo);
  }
@supports (animation-timeline: view()) {
@keyframes lift {
      to {
        opacity: 0;
        translate: 0 -8vh;
      }
    }
}
}
</style>
