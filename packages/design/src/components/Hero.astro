---
// The photo at the top of a page. `full` fills the screen (home); `banner` is the short one
// sub-sites open on. The browser morphs one into the other during navigation.
import Rich from "./Rich.astro";
import type { SiteInfo } from "../site";
interface Props { site: SiteInfo; title: string; size?: "full" | "banner"; animate?: boolean; tagline?: string; next?: string; transitionName?: string; id?: string }
const { site, title, size = "banner", animate = size === "full", tagline, next, transitionName, id = "name" } = Astro.props;
const { photo } = site;
const birds = [[0, 20, 1], [18, 10, 0.8], [30, 26, 0.9], [46, 14, 0.7], [62, 24, 0.85], [78, 8, 0.6]];
---
<section class:list={["hero", size === "banner" && "hero--banner"]} aria-labelledby={id}>
  <div class="scene" aria-hidden="true">
    <img src={photo.src} srcset={photo.srcset} sizes="100vw" alt="" width={photo.width} height={photo.height} fetchpriority="high" />
  </div>
  <div class="sky-life" aria-hidden="true" data-loop>
    {[0, 1].map((f) => (
      <svg class="flock" style={`--f:${f}`} viewBox="0 0 120 50" width="120" height="50">
        {birds.map(([x, y, sc], b) => (
          <g transform={`translate(${x} ${y}) scale(${sc})`}><path class="bird" style={`--b:${b}`} d="M0 6 Q5 0 10 6 Q15 0 20 6" /></g>
        ))}
      </svg>
    ))}
  </div>
  <div class="hero-copy">
    {animate ? (
      <h1 id={id} aria-label={title}>
        {title.split(" ").map((word, w) => (
          <span class="word" aria-hidden="true">{[...word].map((ch, i) => <span class="ch" style={`--i:${w * 6 + i}`}>{ch}</span>)}</span>
        ))}
      </h1>
    ) : <h1 id={id}><span class="hero-title" style={transitionName && `view-transition-name:${transitionName}`}>{title}</span></h1>}
    {tagline && <p class="tagline"><Rich text={tagline} /></p>}
    <slot />
  </div>
  <p class="credit">Photo: <a href={photo.credit.href} target="_blank" rel="noopener noreferrer">{photo.credit.author}</a> on {photo.credit.source}</p>
  {next && <a class="scroll-cue" href={next} aria-label="Scroll to the content"><span></span></a>}
</section>
