---
// The end of every page: the last words, the profiles, and the other sites.
import Icon from "./Icon.astro";
import SiteLinks from "./SiteLinks.astro";
import type { SiteLinksInfo } from "../site";
interface Props { site: SiteLinksInfo; title: string; line: string; links: readonly { label: string; href: string; icon: "github" | "linkedin" | "substack" }[] }
const { site, title, line, links } = Astro.props;
---
<footer id="contact" class="ending">
  <h2 class="tbc">{title}</h2>
  <p class="ending-line">{line}</p>
  <ul class="end-links">
    {links.map((l) => <li><a href={l.href} target="_blank" rel="noopener noreferrer"><Icon name={l.icon} size={17} /> {l.label}</a></li>)}
  </ul>
  <SiteLinks site={site} />
  <slot />
</footer>
