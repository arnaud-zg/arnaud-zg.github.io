---
// A quiet way in: one bird of the hero's flock, landed at the end of the page.
interface Props { href: string; label: string }
const { href, label } = Astro.props;
---
<a class="secret-bird" href={href} aria-label={label} title="?">
  <svg viewBox="0 0 24 14" width="24" height="14" aria-hidden="true"><path d="M2 10 Q7 3 12 10 Q17 3 22 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
</a>

<style is:global>
.secret-bird {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  margin-top: 24px;
  color: var(--ink-lo);
  opacity: 0.45;
  transition:
    opacity 300ms var(--ease-out),
    color 300ms var(--ease-out),
    translate 600ms var(--ease-out);
}
.secret-bird:hover,
.secret-bird:focus-visible {
  opacity: 1;
  color: var(--accent);
  translate: 4px -8px;
}
@media (prefers-reduced-motion: no-preference) {
.secret-bird:is(:hover, :focus-visible) path {
    transform-box: fill-box;
    transform-origin: center;
    animation: bird-flap 220ms ease-in-out infinite alternate;
  }
@keyframes bird-flap {
    to {
      scale: 1 0.35;
    }
  }
}
</style>
