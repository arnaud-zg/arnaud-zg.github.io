---
// A card that is one link. Links that leave the origin open in a new tab; the rest stay, so the
// page transition can run.
interface Props { href: string; name: string; text: string; transitionName?: string }
const { href, name, text, transitionName } = Astro.props;
import Go from "./Go.astro";
const leaves = /^https?:/.test(href);
import "./parts/press.css";
---
<a class="link-card" href={href} {...(leaves ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
  <Go leaves={leaves} />
  <span class="link-card-name"><span style={transitionName && `view-transition-name:${transitionName}`}>{name}</span></span>
  <span class="link-card-text">{text}</span>
</a>

<style is:global>
.link-card {
  position: relative;
  display: grid;
  align-content: start;
  gap: 6px;
  height: 100%;
  padding: 18px 20px;
  border-radius: 14px;
  border: 1px solid var(--line);
  background: var(--surface);
  transition:
    border-color 260ms var(--ease-out),
    translate 260ms var(--ease-out),
    box-shadow 260ms var(--ease-out);
}
.link-card:hover,
.link-card:focus-visible {
  border-color: var(--accent);
  translate: 0 -2px;
  box-shadow: var(--shadow-lift);
}
.link-card-name {
  padding-right: 28px;
  font: 500 0.92rem/1.4 var(--mono);
  color: var(--accent);
  overflow-wrap: anywhere;
}
.link-card-text {
  font-size: var(--fs-small);
  line-height: 1.5;
  color: var(--ink-lo);
}
@media (prefers-reduced-motion: no-preference) {
@supports (animation-timeline: view()) {
.link-card {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry calc(5% + var(--row, 0) * 7%) cover calc(20% + var(--row, 0) * 3%);
    }
}
}
</style>
