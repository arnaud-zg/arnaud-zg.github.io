---
// A card that is one link. Links that leave the origin open in a new tab; the rest stay, so the
// page transition can run.
interface Props { href: string; name: string; text: string; transitionName?: string }
const { href, name, text, transitionName } = Astro.props;
const leaves = /^https?:/.test(href);
---
<a class="link-card" href={href} aria-label={`${name}: ${text}`} {...(leaves ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
  <span class="go" aria-hidden="true">{leaves ? "↗" : "→"}</span>
  <span class="link-card-name"><span style={transitionName && `view-transition-name:${transitionName}`}>{name}</span></span>
  <span class="link-card-text">{text}</span>
</a>
