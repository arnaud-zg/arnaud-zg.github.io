---
import { siGithub, siSubstack } from "simple-icons";
interface Props { name: "github" | "linkedin" | "substack" | "star" | "arrow" | "pr" | "bird"; size?: number }
const { name, size = 20 } = Astro.props;
const paths: Record<string, string> = {
  github: siGithub.path,
  substack: siSubstack.path,
  linkedin: "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z",
};
---
{paths[name] ? (
  <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path d={paths[name]} fill="currentColor" /></svg>
) : name === "star" ? (
  <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" fill="currentColor"/></svg>
) : name === "pr" ? (
  <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="5" r="2.2"/><circle cx="6" cy="19" r="2.2"/><circle cx="18" cy="19" r="2.2"/><path d="M6 7.2v9.6M18 16.8V10a3 3 0 0 0-3-3h-4m0 0 2.5-2.5M11 7l2.5 2.5"/></svg>
) : name === "bird" ? (
  <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path d="M2 14 Q7 7 12 14 Q17 7 22 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
) : (
  <svg class="arrow" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
)}
