---
import type { Choice } from "../variants";
import { dialogVariants } from "./Dialog.variants";
// `lede`: one line under the title. The `foot` slot holds the dialog's actions, always in view.
interface Props extends Partial<Choice<typeof dialogVariants.axes>> { id: string; title: string; lede?: string }
const { id, title, lede, size = dialogVariants.defaults.size } = Astro.props;
const foot = Astro.slots.has("foot");
import "./parts/press.css";
---
<dialog id={id} class="dialog" {...dialogVariants.attrs({ size })} aria-labelledby={`${id}-title`}>
  <header class="dialog-head">
    <div class="dialog-title">
      <h2 id={`${id}-title`}>{title}</h2>
      {lede && <p class="dialog-lede">{lede}</p>}
    </div>
    <button class="dialog-close" type="button" data-close-dialog aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
  </header>
  <div class="dialog-body"><slot /></div>
  {foot && <footer class="dialog-foot"><slot name="foot" /></footer>}
</dialog>

<style is:global>
.dialog-close::after {
  content: "";
  position: absolute;
  inset: -4px;
}
.dialog {
  width: min(1100px, calc(100vw - 32px));
  max-height: min(80vh, 820px);
  padding: 0;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--bg);
  color: var(--ink);
  overflow: hidden;
  display: none;
  flex-direction: column;
}
.dialog[data-size="narrow"] {
  width: min(680px, calc(100vw - 32px));
}
.dialog[open] {
  display: flex;
}
.dialog::backdrop {
  background: rgba(4, 6, 15, 0.6);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}
.dialog-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 22px 28px;
  border-bottom: 1px solid var(--line);
}
.dialog-head h2 {
  font-size: var(--fs-h3);
  font-weight: 400;
  letter-spacing: 0.04em;
}
.dialog-title {
  display: grid;
  gap: 4px;
}
.dialog-lede {
  font-size: var(--fs-small);
  color: var(--ink-lo);
}
.dialog-foot {
  display: flex;
  justify-content: flex-end;
  padding: 16px 28px;
  border-top: 1px solid var(--line);
}
.dialog-close {
  position: relative;
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  flex: none;
  border-radius: 50%;
  border: 1px solid var(--line);
  background: none;
  color: var(--ink);
  cursor: pointer;
  transition:
    border-color 200ms var(--ease-out),
    color 200ms var(--ease-out);
}
.dialog-close:hover {
  border-color: var(--accent);
  color: var(--accent);
}
.dialog-body {
  min-height: 0;
  overflow-y: auto;
  padding: 0 28px 12px;
  overscroll-behavior: contain;
}
@media (prefers-reduced-motion: no-preference) {
.dialog[open] {
    transition:
      opacity var(--dur-enter) var(--ease-out),
      translate var(--dur-enter) var(--ease-out),
      scale var(--dur-enter) var(--ease-out);
  }
.dialog::backdrop {
    transition: opacity var(--dur-enter) ease;
  }
.dialog.is-leaving {
    opacity: 0;
    translate: 0 14px;
    scale: 0.98;
    transition-duration: var(--dur-leave);
    transition-timing-function: var(--ease-in);
  }
.dialog.is-leaving::backdrop {
    opacity: 0;
    transition-duration: var(--dur-leave);
  }
@starting-style  {
.dialog[open] {
      opacity: 0;
      translate: 0 14px;
      scale: 0.98;
    }
.dialog[open]::backdrop {
      opacity: 0;
    }
}
}
</style>
