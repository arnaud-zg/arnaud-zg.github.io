---
// Covers in a row, newest first.
import { external } from "../links";
interface Props { items: { title: string; url: string; date: string; dateText: string; image?: string }[] }
const { items } = Astro.props;
---
<ul class="articles">
  {items.map((a, i) => (
    <li style={`--a:${i}`}>
      <a class="article" href={a.url} {...external}>
        <span class="cover">{a.image && <img src={a.image} alt="" loading="lazy" decoding="async" width="720" height="480" />}</span>
        <time datetime={a.date}>{a.dateText}</time>
        <span class="a-title">{a.title}</span>
      </a>
    </li>
  ))}
</ul>

<style is:global>
.articles {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24px;
}
.article {
  display: grid;
  gap: 10px;
  align-content: start;
}
.cover {
  display: block;
  aspect-ratio: 3 / 2;
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--surface-hi);
  margin-bottom: 6px;
}
.cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: brightness(0.85) saturate(0.9);
  transition:
    scale 700ms var(--ease-out),
    filter 500ms var(--ease-out);
}
.article time {
  font: 400 var(--fs-label)/1.6 var(--mono);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-lo);
}
.a-title {
  line-height: 1.5;
  transition: color 300ms var(--ease-out);
}
.article:hover .cover img {
  scale: 1.04;
  filter: none;
}
.article:hover .a-title {
  color: var(--accent);
}
@media (prefers-reduced-motion: no-preference) {
@supports (animation-timeline: view()) {
.cover {
      animation: shutter linear both;
      animation-timeline: view();
      animation-range: entry calc(10% + var(--a, 0) * 7%) cover calc(30% + var(--a, 0) * 7%);
    }
@keyframes shutter {
      from {
        clip-path: inset(0 0 100% 0 round var(--radius));
      }
      to {
        clip-path: inset(0 0 0 0 round var(--radius));
      }
    }
}
}
@media (max-width: 960px) {
.articles {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 640px) {
.articles {
    grid-template-columns: minmax(0, 1fr);
  }
}
</style>
