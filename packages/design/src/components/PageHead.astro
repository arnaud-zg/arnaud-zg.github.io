---
// The top of a page without the photo: title and tagline on the page itself.
interface Props { title: string; tagline?: string; transitionName?: string }
const { title, tagline, transitionName } = Astro.props;
---
<header class="page-head">
  <h1><span class="hero-title" style={transitionName && `view-transition-name:${transitionName}`}>{title}</span></h1>
  {tagline && <p class="lede">{tagline}</p>}
</header>
