---
// One row per repository. The bar's length is lines changed, against `max`.
import { external } from "../links";
export type DiffRepo = { repo: string; about: string; kinds: string; added: number; removed: number; href: string };
interface Props { items: DiffRepo[]; max: number }
const { items, max } = Astro.props;
const pct = (n: number) => `--w:${(n / max) * 100}%`;
import "./parts/repo-owner.css";
import "./parts/diff-bar.css";
---
<ul class="ds-list">
  {items.map((r) => (
    <li class="ds-repo-row">
      <div class="ds-row">
        <a class="ds-repo" href={r.href} {...external}><span class="owner">{r.repo.split("/")[0]}/</span>{r.repo.split("/")[1]}</a>
        <span class="ds-count"><span class="ds-about">{r.about}</span><span class="ds-kinds">{r.kinds}</span></span>
        <span class="diff"><b>+{r.added}</b> <i>−{r.removed}</i></span>
        <span class="ds-bar ds-row-bar" aria-hidden="true"><b style={pct(r.added)}></b><i style={pct(r.removed)}></i></span>
      </div>
    </li>
  ))}
</ul>

<style is:global>
.ds-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr) 7rem minmax(160px, 1.3fr);
  gap: 0 clamp(12px, 1.8vw, 24px);
  align-items: center;
}
.ds-repo-row {
  padding: 14px 0;
  border-bottom: 1px solid var(--line);
}
.ds-repo {
  font-size: 1.12rem;
  letter-spacing: 0.01em;
  overflow-wrap: break-word;
  transition: color 300ms var(--ease-out);
}
.ds-repo:hover {
  color: var(--accent);
}
.ds-count {
  display: grid;
  gap: 2px;
}
.ds-about {
  font-size: var(--fs-small);
  line-height: 1.45;
  color: var(--ink-lo);
}
.ds-kinds {
  font: 400 var(--fs-label)/1.6 var(--mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-lo);
}
.ds-repo .owner {
  display: block;
  line-height: 1.2;
}
.ds-list {
  border-top: 1px solid var(--line);
}
.dialog-body .ds-list {
  border-top: 0;
}
@media (prefers-reduced-motion: no-preference) {
@supports (animation-timeline: view()) {
.ds-repo-row {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 25%;
    }
}
}
@media (max-width: 960px) {
.ds-row {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "repo diff" "about about" "bar bar";
    gap: 6px 16px;
    align-items: end;
  }
.ds-repo {
    grid-area: repo;
  }
.ds-row .diff {
    grid-area: diff;
    text-align: right;
  }
.ds-count {
    grid-area: about;
  }
.ds-row-bar {
    grid-area: bar;
    margin-top: 6px;
  }
}
</style>
