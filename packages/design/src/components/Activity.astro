---
// The whole record by repository, the largest first: the years it spans, how many pull requests,
// and the lines they added and removed once merged, as a bar against the largest. The first `top`
// are listed, each with its latest pull requests; the rest open in a dialog. A repository with
// more pull requests than its row shows opens them all in its own dialog.
import { external } from "../links";
import ActivityThreads from "./ActivityThreads.astro";
import Dialog from "./Dialog.astro";
import Pill from "./Pill.astro";
export type ActivityStatus = "merged" | "review";
export type ActivityThread = { status: ActivityStatus; title: string; href: string; reported?: { number: string; href: string }[] };
export type ActivityRepo = { repo: string; about: string; href: string; years: string; prs: string; added: number; removed: number; threads: ActivityThread[] };
export type ActivityLabels = Record<ActivityStatus, string> & {
  reported: (n: string) => string;
  details: (n: number) => string;
  more: (n: number) => string;
  moreTitle: string;
  onGitHub: string;
};
interface Props { id: string; items: ActivityRepo[]; top?: number; labels: ActivityLabels }
const { id, items, top = 4, labels } = Astro.props;
// A row shows this many pull requests at most: every row keeps the same height.
const PREVIEW = 2;
const size = (r: ActivityRepo) => r.added + r.removed;
// A stable sort: equal sizes keep the given order, the latest activity first.
const ranked = [...items].sort((a, b) => size(b) - size(a));
const shown = ranked.slice(0, top);
const rest = ranked.slice(top);
const max = Math.max(1, ...items.map(size));
const pct = (n: number) => `--w:${(n / max) * 100}%`;
const dialogOf = (i: number) => `${id}-${i}`;
import "./parts/repo-owner.css";
import "./parts/diff-bar.css";
---
<div class="activity">
  <ul class="act-list">
    {shown.map((r, i) => (
      <li class="act-repo">
        <div class="act-head">
          <a class="act-name" href={r.href} {...external}><span class="owner">{r.repo.split("/")[0]}/</span>{r.repo.split("/")[1]}</a>
          {r.about && <p class="act-about">{r.about}</p>}
        </div>
        <div class="act-body">
          <div class="act-stats">
            <span class="act-meta">{r.years} · {r.prs}</span>
            {size(r) > 0 && <span class="diff"><b>+{r.added}</b> <i>−{r.removed}</i></span>}
            {size(r) > 0 && <span class="ds-bar act-bar" aria-hidden="true"><b style={pct(r.added)}></b><i style={pct(r.removed)}></i></span>}
          </div>
          {r.threads.length > 0 && <ActivityThreads items={r.threads.slice(0, PREVIEW)} labels={labels} />}
          {r.threads.length > PREVIEW && <button class="act-open" type="button" data-open-dialog={dialogOf(i)} aria-haspopup="dialog">{labels.details(r.threads.length)} <span aria-hidden="true">→</span></button>}
        </div>
      </li>
    ))}
  </ul>
  {rest.length > 0 && <div class="act-foot"><Pill opens={`${id}-more`}>{labels.more(rest.length)}</Pill></div>}
</div>

{shown.map((r, i) => r.threads.length > PREVIEW && (
  <Dialog id={dialogOf(i)} title={r.repo} size="narrow">
    <div class="act-sheet">
      {r.about && <p class="act-about">{r.about}</p>}
      <div class="act-stats">
        <span class="act-meta">{r.years} · {r.prs}</span>
        {size(r) > 0 && <span class="diff"><b>+{r.added}</b> <i>−{r.removed}</i></span>}
        {size(r) > 0 && <span class="ds-bar act-bar" aria-hidden="true"><b style={pct(r.added)}></b><i style={pct(r.removed)}></i></span>}
      </div>
      <ActivityThreads items={r.threads} labels={labels} />
      <a class="act-cta" href={r.href} {...external}>{labels.onGitHub} <span aria-hidden="true">↗</span></a>
    </div>
  </Dialog>
))}

{rest.length > 0 && (
  <Dialog id={`${id}-more`} title={labels.moreTitle} size="narrow">
    <ul class="act-small">
      {rest.map((r) => (
        <li class="act-row">
          <div class="act-row-head">
            <a class="act-name" href={r.href} {...external}><span class="owner">{r.repo.split("/")[0]}/</span>{r.repo.split("/")[1]}</a>
            {size(r) > 0 && <span class="diff"><b>+{r.added}</b> <i>−{r.removed}</i></span>}
          </div>
          {r.about && <p class="act-about">{r.about}</p>}
          <span class="act-meta">{r.years} · {r.prs}</span>
          {r.threads.length > 0 && <ActivityThreads items={r.threads} labels={labels} />}
        </li>
      ))}
    </ul>
  </Dialog>
)}

<style is:global>
.activity {
  display: grid;
  gap: 22px;
}
.act-list {
  border-top: 1px solid var(--line);
}
.act-repo {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
  gap: 10px clamp(12px, 1.8vw, 24px);
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
}
.act-head {
  display: grid;
  gap: 4px;
  align-content: start;
}
.act-name {
  font-size: 1.12rem;
  letter-spacing: 0.01em;
  overflow-wrap: break-word;
}
.act-name .owner {
  display: block;
  line-height: 1.2;
}
.act-about {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: var(--fs-small);
  line-height: 1.45;
  color: var(--ink-lo);
}
.act-body {
  display: grid;
  gap: 12px;
  align-content: start;
}
.act-stats {
  display: grid;
  grid-template-columns: 9.5rem 7rem minmax(0, 1fr);
  gap: 0 16px;
  align-items: center;
}
.act-meta {
  font: 400 var(--fs-label)/1.6 var(--mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
  color: var(--ink-lo);
}
.act-open,
.act-cta {
  justify-self: start;
  padding: 0;
  border: 0;
  background: none;
  font: 400 var(--fs-label)/1.6 var(--mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
  cursor: pointer;
}
.act-open:hover,
.act-cta:hover {
  text-decoration: underline;
  text-underline-offset: 0.25em;
}
.act-foot {
  display: flex;
  justify-content: flex-start;
}
.act-sheet {
  display: grid;
  gap: 18px;
  padding: 22px 0 16px;
}
.act-sheet .act-about {
  display: block;
}
.act-sheet .act-stats {
  grid-template-columns: auto auto minmax(0, 1fr);
}
.act-small {
  display: grid;
}
.act-row {
  display: grid;
  gap: 8px;
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
}
.act-row:last-child {
  border-bottom: 0;
}
.act-row-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16px;
}
.act-name:hover {
  color: var(--accent);
}
@media (prefers-reduced-motion: no-preference) {
.act-name {
    transition: color 300ms var(--ease-out);
  }
@supports (animation-timeline: view()) {
.act-repo {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 25%;
    }
}
}
@media (max-width: 960px) {
.act-repo {
    grid-template-columns: minmax(0, 1fr);
  }
.act-stats,
.act-sheet .act-stats {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 16px;
  }
.act-bar {
    grid-column: 1 / -1;
  }
}
</style>
