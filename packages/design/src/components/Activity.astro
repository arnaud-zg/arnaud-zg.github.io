---
// The whole record by repository, the latest activity first: the years it spans, how many pull
// requests, and the lines they added and removed once merged, as a bar against the largest. Under
// it, the pull requests of the last months, each with a dot for its status (filled: merged,
// hollow: in review). An issue reported first folds into the pull request that closes it.
import { external } from "../links";
export type ActivityStatus = "merged" | "review";
export type ActivityThread = { status: ActivityStatus; title: string; href: string; reported?: { number: string; href: string }[] };
export type ActivityRepo = { repo: string; about: string; href: string; years: string; prs: string; added: number; removed: number; threads: ActivityThread[] };
interface Props { items: ActivityRepo[]; labels: Record<ActivityStatus, string> & { reported: (n: string) => string } }
const { items, labels } = Astro.props;
const max = Math.max(1, ...items.map((r) => r.added + r.removed));
const pct = (n: number) => `--w:${(n / max) * 100}%`;
import "./parts/repo-owner.css";
import "./parts/diff-bar.css";
---
<ul class="act-list">
  {items.map((r) => (
    <li class="act-repo">
      <div class="act-head">
        <a class="act-name" href={r.href} {...external}><span class="owner">{r.repo.split("/")[0]}/</span>{r.repo.split("/")[1]}</a>
        {r.about && <p class="act-about">{r.about}</p>}
      </div>
      <div class="act-body">
        <div class="act-stats">
          <span class="act-meta">{r.years} · {r.prs}</span>
          {r.added + r.removed > 0 && <span class="diff"><b>+{r.added}</b> <i>−{r.removed}</i></span>}
          {r.added + r.removed > 0 && <span class="ds-bar act-bar" aria-hidden="true"><b style={pct(r.added)}></b><i style={pct(r.removed)}></i></span>}
        </div>
        {r.threads.length > 0 && (
          <ul class="act-threads">
            {r.threads.map((t) => (
              <li class={`act-thread is-${t.status}`}>
                <span class="act-dot" role="img" aria-label={labels[t.status]} title={labels[t.status]}></span>
                <span class="act-what">
                  <a class="act-title" href={t.href} {...external}>{t.title}</a>
                  {t.reported?.map((i) => <a class="act-note" href={i.href} {...external}>{labels.reported(i.number)}</a>)}
                </span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </li>
  ))}
</ul>

<style is:global>
.act-list {
  border-top: 1px solid var(--line);
}
.act-repo {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
  gap: 10px clamp(12px, 1.8vw, 24px);
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
}
.act-head {
  display: grid;
  gap: 4px;
  align-content: start;
}
.act-name {
  font-size: 1.12rem;
  letter-spacing: 0.01em;
  overflow-wrap: break-word;
}
.act-name .owner {
  display: block;
  line-height: 1.2;
}
.act-about {
  font-size: var(--fs-small);
  line-height: 1.45;
  color: var(--ink-lo);
}
.act-body {
  display: grid;
  gap: 12px;
  align-content: start;
}
.act-stats {
  display: grid;
  grid-template-columns: 9.5rem 7rem minmax(0, 1fr);
  gap: 0 16px;
  align-items: center;
}
.act-meta {
  font: 400 var(--fs-label)/1.6 var(--mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
  color: var(--ink-lo);
}
.act-threads {
  display: grid;
  gap: 8px;
}
.act-thread {
  display: grid;
  grid-template-columns: 8px minmax(0, 1fr);
  gap: 0 12px;
  align-items: baseline;
}
.act-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: 1.5px solid var(--ink-lo);
}
.is-merged .act-dot {
  border-color: var(--added);
  background: var(--added);
}
.act-what {
  display: grid;
  gap: 2px;
}
.act-title {
  font-size: var(--fs-small);
  line-height: 1.45;
  overflow-wrap: break-word;
}
.is-review .act-title {
  color: var(--ink-lo);
}
.act-note {
  font: 400 var(--fs-label)/1.6 var(--mono);
  letter-spacing: 0.06em;
  color: var(--ink-lo);
}
.act-name:hover,
.act-title:hover,
.act-note:hover {
  color: var(--accent);
}
@media (prefers-reduced-motion: no-preference) {
.act-name,
.act-title,
.act-note {
    transition: color 300ms var(--ease-out);
  }
@supports (animation-timeline: view()) {
.act-repo {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 25%;
    }
}
}
@media (max-width: 960px) {
.act-repo {
    grid-template-columns: minmax(0, 1fr);
  }
.act-stats {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 16px;
  }
.act-bar {
    grid-column: 1 / -1;
  }
}
</style>
