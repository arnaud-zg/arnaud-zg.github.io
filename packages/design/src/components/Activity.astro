---
// The whole record by repository, the largest first: the years it spans, how many pull requests,
// and the lines they added and removed once merged, as a bar against the largest. The first `top`
// are listed; the rest open in a dialog, as the same rows. Every row shows its latest pull
// requests, the same few in each so the rows keep one height; a repository with more opens them
// all in its own dialog, from the list or from the dialog of the rest.
import { external } from "../links";
import ActivityRow from "./ActivityRow.astro";
import ActivityThreads from "./ActivityThreads.astro";
import Dialog from "./Dialog.astro";
import Pill from "./Pill.astro";
export type ActivityStatus = "merged" | "review";
export type ActivityThread = { status: ActivityStatus; title: string; href: string; reported?: { number: string; href: string }[] };
export type ActivityRepo = { repo: string; about: string; href: string; years: string; prs: string; added: number; removed: number; threads: ActivityThread[] };
export type ActivityLabels = Record<ActivityStatus, string> & {
  reported: (n: string) => string;
  details: (n: number) => string;
  more: (n: number) => string;
  moreTitle: string;
  onGitHub: string;
};
interface Props { id: string; items: ActivityRepo[]; top?: number; labels: ActivityLabels }
const { id, items, top = 4, labels } = Astro.props;
// A row shows this many pull requests at most: every row keeps the same height.
const PREVIEW = 2;
const size = (r: ActivityRepo) => r.added + r.removed;
// A stable sort: equal sizes keep the given order, the latest activity first.
const ranked = [...items].sort((a, b) => size(b) - size(a));
const shown = ranked.slice(0, top);
const rest = ranked.slice(top);
const max = Math.max(1, ...items.map(size));
const pct = (n: number) => `--w:${(n / max) * 100}%`;
const dialogOf = (i: number) => `${id}-${i}`;
const opens = (i: number) => (ranked[i].threads.length > PREVIEW ? dialogOf(i) : undefined);
import "./parts/diff-bar.css";
---
<div class="activity">
  <ul class="act-list">
    {shown.map((r, i) => <ActivityRow repo={r} max={max} preview={PREVIEW} opens={opens(i)} labels={labels} />)}
  </ul>
  {rest.length > 0 && <div class="act-foot"><Pill opens={`${id}-more`}>{labels.more(rest.length)}</Pill></div>}
</div>

{rest.length > 0 && (
  <Dialog id={`${id}-more`} title={labels.moreTitle} size="narrow">
    <ul class="act-small">
      {rest.map((r, i) => <ActivityRow repo={r} max={max} preview={PREVIEW} opens={opens(top + i)} compact labels={labels} />)}
    </ul>
  </Dialog>
)}

{ranked.map((r, i) => opens(i) && (
  <Dialog id={dialogOf(i)} title={r.repo} size="narrow">
    <div class="act-sheet">
      {r.about && <p class="act-about">{r.about}</p>}
      <div class="act-stats">
        <span class="act-meta">{r.years} · {r.prs}</span>
        {size(r) > 0 && <span class="diff"><b>+{r.added}</b> <i>−{r.removed}</i></span>}
        {size(r) > 0 && <span class="ds-bar act-bar" aria-hidden="true"><b style={pct(r.added)}></b><i style={pct(r.removed)}></i></span>}
      </div>
      <ActivityThreads items={r.threads} labels={labels} />
      <a class="act-cta" href={r.href} {...external}>{labels.onGitHub} <span aria-hidden="true">↗</span></a>
    </div>
  </Dialog>
))}

<style is:global>
.activity {
  display: grid;
  gap: 22px;
}
.act-list {
  border-top: 1px solid var(--line);
}
.act-foot {
  display: flex;
  justify-content: flex-start;
}
.act-small {
  display: grid;
  padding-top: 4px;
}
.act-sheet {
  display: grid;
  gap: 18px;
  padding: 22px 0 16px;
}
.act-sheet .act-about {
  display: block;
}
.act-sheet .act-stats {
  grid-template-columns: auto auto minmax(0, 1fr);
}
.act-cta {
  justify-self: start;
  font: 400 var(--fs-label)/1.6 var(--mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
}
.act-cta:hover {
  text-decoration: underline;
  text-underline-offset: 0.25em;
}
@media (max-width: 960px) {
.act-sheet .act-stats {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 16px;
  }
}
</style>
