---
// The corner arrow of a card that is a link: ↗ when it leaves the site, → when it stays. With
// `href`, the arrow is a link of its own, named by `label`, on a card that does something else.
import { external } from "../links";
interface Props { leaves?: boolean; href?: string; label?: string }
const { leaves, href, label } = Astro.props;
const arrow = leaves ? "↗" : "→";
---
{href ? <a class="go" href={href} aria-label={label} title={label} {...(leaves ? external : {})}>{arrow}</a> : <span class="go" aria-hidden="true">{arrow}</span>}

<style is:global>
.go {
  position: absolute;
  top: 10px;
  right: 12px;
  display: grid;
  place-items: center;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 0.8rem;
  opacity: 0;
  translate: -4px 4px;
  transition:
    opacity 220ms var(--ease-out),
    translate 220ms var(--ease-out);
}
.link-card:hover .go,
.link-card:focus-visible .go,
.link-card:focus-within .go {
  opacity: 1;
  translate: 0 0;
}
a.go {
  z-index: 2;
  width: 30px;
  height: 30px;
  top: 8px;
  right: 8px;
}
a.go:hover,
a.go:focus-visible {
  background: var(--accent);
  color: var(--bg);
}
@media (hover: none) {
a.go {
    opacity: 1;
    translate: 0 0;
  }
}
.earlier-card:hover .go,
.earlier-card:focus-visible .go {
  opacity: 1;
  translate: 0 0;
}
</style>
