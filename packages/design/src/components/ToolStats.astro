---
// The figures of one tool, real ones only.
import { compact, type Tool, type ToolLabels } from "../treemap";
interface Props { tool: Tool; labels: ToolLabels; class: "tm-stats" | "sq-stats" }
const { tool, labels, class: name } = Astro.props;
---
<span class={name} title={tool.month}>
  {tool.downloads !== undefined && <span class="stat"><b><i aria-hidden="true">⬇️</i>{compact(tool.downloads)}</b><small>{labels.monthlyDownloads}</small></span>}
  <span class="stat"><b><i aria-hidden="true">🚀</i>{tool.monthlyReleases}</b><small>{labels.monthlyReleases}</small></span>
  {tool.members > 1 && <span class="stat"><b><i aria-hidden="true">🧩</i>{tool.members - 1}</b><small>{labels.plugins}</small></span>}
</span>

<style is:global>
.tm-stats {
  display: none;
  margin-top: auto;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}
.tm-stats,
.sq-stats {
  flex-wrap: wrap;
  row-gap: 12px;
  margin-left: -19px;
  clip-path: inset(-1em 0 -1em 19px);
}
.stat[hidden] {
  display: none;
}
.stat {
  display: grid;
  gap: 3px;
  align-content: start;
  padding: 0 18px;
  border-left: 1px solid var(--line);
}
.stat b {
  display: flex;
  align-items: baseline;
  gap: 6px;
  font-weight: 300;
  font-size: 1.45rem;
  line-height: 1;
  letter-spacing: -0.01em;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.stat i {
  font-style: normal;
  font-size: 0.8rem;
  translate: 0 -0.15em;
}
.stat small {
  font: 400 0.62rem/1.3 var(--mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-lo);
  white-space: nowrap;
}
.tm-tile.is-focus .tm-stats {
  display: flex;
}
.tm-tile.is-focus .tm-stats {
  margin-top: 10px;
}
.sq-stats {
  display: flex;
  margin-top: 10px;
  padding-top: 12px;
  border-top: 1px solid var(--line);
}
.sq-stats .stat b {
  font-size: 1.25rem;
}
</style>
