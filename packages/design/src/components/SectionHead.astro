---
// The head of a section. The slot sits under the lede: figures.
interface Props { id?: string; title: string; lede?: string }
const { id, title, lede } = Astro.props;
---
<header class="section-head">
  <h2 id={id}>{title}</h2>
  {lede && <p class="lede">{lede}<slot name="lede" /></p>}
  <slot />
</header>
