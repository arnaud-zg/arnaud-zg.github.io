---
import Crumbs from "./Crumbs.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import { currentSite, homePath, otherSites, type SiteLinksInfo } from "../site";
interface Props { site: SiteLinksInfo; nav: { href: string; label: string }[]; solid?: boolean }
const { site, nav, solid = false } = Astro.props;
const here = currentSite(site);
const others = otherSites(site).filter((s) => s.id !== "home");
import "./parts/press.css";
---
<header class:list={["masthead", solid && "is-scrolled"]} data-solid={solid || undefined}>
  <Crumbs site={site} />
  <nav class="nav-wide" aria-label="Main">
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    {others.map((s) => <a class="nav-site" href={s.path}>{s.label}</a>)}
  </nav>
  <ThemeSwitch />
  <button class="menu-button" type="button" popovertarget="site-menu" aria-label="Menu">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 8.5h16M4 15.5h16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
  </button>
  <div class="menu" id="site-menu" popover>
    <nav aria-label="Menu">
      {nav.map((n) => <a href={n.href} data-menu-link>{n.label}</a>)}
      {(here?.id !== "home" || others.length > 0) && <hr />}
      {here?.id !== "home" && <a href={homePath(site)} data-menu-link>{site.brand}</a>}
      {others.map((s) => <a href={s.path} data-menu-link>{s.label}</a>)}
    </nav>
  </div>
</header>

<style is:global>
.masthead {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 22px var(--edge);
  color: var(--on-photo);
  transition:
    padding 300ms var(--ease-out),
    background-color 300ms var(--ease-out),
    color 300ms var(--ease-out),
    border-color 300ms var(--ease-out);
  border-bottom: 1px solid transparent;
}
.masthead.is-scrolled {
  padding-block: 12px;
  color: var(--ink);
  background: color-mix(in srgb, var(--bg) 78%, transparent);
  border-bottom-color: var(--line);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
.masthead.is-scrolled .nav-wide a {
  color: var(--ink-lo);
}
.masthead.is-scrolled .nav-wide a:hover {
  color: var(--ink);
}
.nav-wide {
  display: flex;
  gap: clamp(18px, 2.6vw, 36px);
  font-size: 0.88rem;
  letter-spacing: 0.08em;
}
.nav-wide a {
  position: relative;
  /* A 44px tap target; the negative margin keeps the header's height. */
  padding-block: 10px;
  margin-block: -10px;
  color: var(--on-photo-lo);
  transition: color 200ms var(--ease-out);
}
.nav-wide a::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 6px;
  height: 1px;
  background: var(--accent);
  scale: 0 1;
  transform-origin: right;
  transition: scale 300ms var(--ease-out);
}
.nav-wide a:hover {
  color: #fff;
}
.nav-wide a:hover::after {
  scale: 1 1;
  transform-origin: left;
}
.nav-site {
  padding-left: clamp(18px, 2.6vw, 36px);
  border-left: 1px solid var(--on-photo-line);
}
.nav-wide .nav-site::after {
  left: clamp(18px, 2.6vw, 36px);
}
.masthead.is-scrolled .nav-site {
  border-color: var(--line);
}
.menu-button {
  display: none;
  order: 3;
  place-items: center;
  width: 44px;
  height: 44px;
  margin: -7px -12px -7px -12px;
  padding: 0;
  border: 0;
  background: none;
  color: inherit;
  cursor: pointer;
}
.menu {
  inset: 64px var(--edge) auto auto;
  width: min(280px, calc(100vw - 2 * var(--edge)));
  margin: 0;
  padding: 10px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--bg);
  color: var(--ink);
  box-shadow: 0 24px 60px -24px rgba(4, 6, 15, 0.6);
}
.menu nav {
  display: grid;
}
.menu a {
  padding: 10px 14px;
  border-radius: 10px;
}
.menu a:hover,
.menu a:focus-visible {
  background: var(--accent-soft);
  color: var(--accent);
  outline-offset: -2px;
}
.menu hr {
  width: calc(100% - 28px);
  margin: 8px 14px;
  border: 0;
  border-top: 1px solid var(--line);
}
.nav-wide a[aria-current]::after {
  scale: 1 1;
  transform-origin: left;
}
.nav-wide a[aria-current] {
  color: var(--on-photo);
}
.masthead.is-scrolled .nav-wide a[aria-current] {
  color: var(--ink);
}
@media (max-width: 960px) {
.nav-wide {
    display: none;
  }
.menu-button {
    display: grid;
  }
}
@media (prefers-reduced-motion: no-preference) {
.menu:popover-open {
    transition:
      opacity var(--dur-enter) var(--ease-out),
      translate var(--dur-enter) var(--ease-out),
      scale var(--dur-enter) var(--ease-out);
  }
.menu.is-leaving {
    opacity: 0;
    transition-duration: var(--dur-leave);
    transition-timing-function: var(--ease-in);
  }
.menu.is-leaving {
    translate: 0 -8px;
  }
@starting-style  {
.menu:popover-open {
      opacity: 0;
      translate: 0 -8px;
    }
}
.masthead {
    view-transition-name: masthead;
  }
}
@media (prefers-reduced-motion: reduce) {
.nav-wide a::after {
    transition-duration: 0s;
  }
}
</style>
