---
// A whole sub-site page that is not documentation. No hero: it starts with its title.
import Site from "./Site.astro";
import PageHead from "../components/PageHead.astro";
import type { SiteLinksInfo } from "../site";
import Content from "../components/Content.astro";

interface Props { site: SiteLinksInfo; title: string; description: string; nav: { href: string; label: string }[]; heading: string; tagline?: string; transitionName?: string; noindex?: boolean }
const { site, title, description, nav, heading, tagline, transitionName, noindex } = Astro.props;
---
<Site {...{ site, title, description, nav, noindex }} solid>
  <Content>
    <PageHead title={heading} tagline={tagline} transitionName={transitionName} />
    <slot />
  </Content>
</Site>
