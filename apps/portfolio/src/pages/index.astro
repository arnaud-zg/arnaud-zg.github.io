---
import Site from "@arnaud-zg/design/Site.astro";
import Hero from "@arnaud-zg/design/Hero.astro";
import Content from "@arnaud-zg/design/Content.astro";
import LinkCard from "@arnaud-zg/design/LinkCard.astro";
import Command from "@arnaud-zg/design/Command.astro";
import Ending from "@arnaud-zg/design/Ending.astro";
import Intro from "@arnaud-zg/design/Intro.astro";
import Section from "@arnaud-zg/design/Section.astro";
import SectionHead from "@arnaud-zg/design/SectionHead.astro";
import CardGrid from "@arnaud-zg/design/CardGrid.astro";
import Socials from "@arnaud-zg/design/Socials.astro";
import Kpis from "@arnaud-zg/design/Kpis.astro";
import Numbers from "@arnaud-zg/design/Numbers.astro";
import Facts from "@arnaud-zg/design/Facts.astro";
import Roles from "@arnaud-zg/design/Roles.astro";
import Stints from "@arnaud-zg/design/Stints.astro";
import Education from "@arnaud-zg/design/Education.astro";
import Treemap from "@arnaud-zg/design/Treemap.astro";
import Shelf from "@arnaud-zg/design/Shelf.astro";
import Articles from "@arnaud-zg/design/Articles.astro";
import Activity from "@arnaud-zg/design/Activity.astro";
import SecretBird from "@arnaud-zg/design/SecretBird.astro";
import Pill from "@arnaud-zg/design/Pill.astro";
import { Schema } from "astro-seo-schema";
import { external } from "@arnaud-zg/design/links";
import { compact } from "@arnaud-zg/design/treemap";
import Analytics from "../components/Analytics.astro";
import { analytics } from "../analytics";
import config from "../../portfolio.config";
import { portrait, siteInfo } from "../site";
import { profile } from "../profile";
import { formatDate } from "../presenters/date";
import { profilePageOf } from "../presenters/structured-data";
import { treemapOf } from "../presenters/treemap";

const { name, role, links, site, sections, labels } = config;
const { glance: words, about } = sections;
const { education } = config.career;
const career = profile.career();
const quests = profile.sideQuests();
const openSource = profile.contributions();
const articles = profile.articles();
const skills = profile.skills();

const numbers = [
  { value: openSource.calendar.total, unit: labels.contributions, label: words.contributions(openSource.calendar.year) },
  { value: career.longestYears, unit: labels.years, label: words.stay },
  { value: quests.releases, unit: labels.releases, label: words.releases },
];
// Header nav: every shown section that has a nav label, in page order.
const ids: Record<string, string> = { about: "about", journey: "journey", quests: "quests", skills: "skills", writing: "writing", openSource: "open-source" };
const nav = Object.entries(sections).flatMap(([key, sec]) => (sec.show && "nav" in sec && ids[key] ? [{ href: `${import.meta.env.BASE_URL}#${ids[key]}`, label: sec.nav as string }] : []));
const [school, ...studied] = education.find((e) => e.short)?.short?.split(", ") ?? [];
const facts = [
  { label: labels.now, value: career.current.role, note: `${labels.at} ${career.current.company}` },
  { label: labels.experience, value: `${career.years} ${labels.years}` },
  ...(school ? [{ label: labels.education, value: school, note: studied.join(", ") }] : []),
];
const earlier = quests.earlier.map((q) => ({ ...q, year: q.updated.slice(0, 4), label: labels.onNpm(q.name) }));
// The whole record by repository: years, pull requests, lines merged. The component ranks it.
const pullsOf = (repo: string) => `https://github.com/${repo}/pulls?q=${encodeURIComponent(`is:pr author:${config.github.user}`)}`;
const span = (from: number, to: number) => (from === to ? `${from}` : `${from}–${to}`);
const activity = openSource.repos.map((r) => ({ ...r, href: pullsOf(r.repo), years: span(r.from, r.to), prs: labels.prs(r.merged + r.review), threads: r.threads.map((t) => ({ ...t, href: t.url, reported: t.reported.map((i) => ({ ...i, href: i.url })) })) }));
const { figures } = openSource;
const openSourceKpis = [
  { value: `+${figures.added.toLocaleString("en-GB")}`, label: labels.added, tone: "added" as const },
  { value: `−${figures.removed.toLocaleString("en-GB")}`, label: labels.removed, tone: "removed" as const },
  { value: figures.projects, label: labels.projects(figures.projects) },
  ...(figures.from === undefined || figures.to === undefined ? [] : [{ value: span(figures.from, figures.to), label: labels.contributing }]),
];
const questKpis = [
  { value: quests.tools, label: labels.tools },
  ...(quests.month ? [{ value: quests.monthlyReleases, label: labels.releasesIn(quests.month) }] : []),
  ...(quests.downloads !== undefined && quests.month ? [{ value: compact(quests.downloads), label: labels.downloadsIn(quests.month) }] : []),
];
---
<Site site={siteInfo} title={site.title} description={site.description} nav={nav} noindex={import.meta.env.BASE_URL !== "/"}>
  <Schema slot="head" item={profilePageOf(career.current, portrait.src)} />
  <Hero site={siteInfo} size="full" title={name} tagline={config.tagline} role={role} next="#glance">
    <Socials label="Profiles" links={links} />
  </Hero>

  <Content>
    {sections.glance.show && (
    <Section id="glance" space="tight" label={labels.glance}>
      <Numbers items={numbers} />
    </Section>
    )}

    {sections.about.show && (
    <Section id="about" labelledby="about-title">
      <Intro id="about-title" title={about.title} lede={about.lede} portrait={portrait} />
    </Section>
    )}

    {sections.journey.show && (
    <Section id="journey" labelledby="journey-title">
      <SectionHead id="journey-title" title={sections.journey.title} lede={sections.journey.lede} />

      <Facts items={facts} />
      <Roles roles={career.roles} labels={labels} />
      <Stints {...career.early} />
      <Education title={sections.journey.educationTitle} items={education} labels={{ skills: labels.skillsTaught }} />
    </Section>
    )}

    {sections.quests.show && (
    <Section id="quests" labelledby="quests-title">
      <SectionHead id="quests-title" title={sections.quests.title} lede={sections.quests.lede}>
        <Kpis items={questKpis} />
      </SectionHead>
      <Treemap groups={treemapOf(quests.groups)} labels={labels} />
      {earlier.length > 0 && <Shelf emoji="🗃️" title={labels.earlier(earlier.length, earlier[earlier.length - 1].year, earlier[0].year)} items={earlier} />}
    </Section>
    )}

    {sections.skills.show && (
    <Section id="skills" labelledby="skills-title">
      <SectionHead id="skills-title" title={sections.skills.title} lede={sections.skills.lede}>
        <Kpis items={[{ value: skills.length, label: labels.skills }]} />
      </SectionHead>
      <CardGrid>
        {skills.map((k) => <li><LinkCard href={k.href} name={`/${k.name}`} text={k.use} /></li>)}
      </CardGrid>
      <Command label={labels.install} command={config.skills.install} />
    </Section>
    )}

    {sections.writing.show && (
    <Section id="writing" labelledby="writing-title">
      <SectionHead id="writing-title" title={sections.writing.title} lede={`${sections.writing.lede} `}>
        <a slot="lede" class="inline" href={links.find((l) => l.icon === "substack")?.href} {...external}>{labels.readArticles} ↗</a>
      </SectionHead>
      <Articles items={articles.map((a) => ({ ...a, dateText: formatDate(a.date) }))} />
    </Section>
    )}

    {sections.openSource.show && (
    <Section id="open-source" labelledby="oss-title">
      <SectionHead id="oss-title" title={sections.openSource.title} lede={sections.openSource.lede}>
        <Kpis items={openSourceKpis} label={labels.openSourceFigures} />
      </SectionHead>
      <Activity id="oss" items={activity} labels={{ merged: labels.merged, review: labels.inReview, reported: labels.reportedFirst, details: labels.allPrs, more: labels.smallerContributions, moreTitle: labels.smallerTitle, onGitHub: labels.prsOnGitHub }} />
    </Section>
    )}

    {sections.ending.show && <Ending site={siteInfo} title={sections.ending.title} line={sections.ending.line} links={links}>{analytics && <Pill look="quiet" opens="privacy">{config.analytics.words.link}</Pill>}<SecretBird href={`${import.meta.env.BASE_URL}design/`} label="Design workshop" /></Ending>}
  </Content>
  {analytics && <Analytics settings={analytics} />}
</Site>
