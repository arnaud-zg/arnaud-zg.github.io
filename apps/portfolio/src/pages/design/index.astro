---
import Site from "@arnaud-zg/design/Site.astro";
import Hero from "@arnaud-zg/design/Hero.astro";
import Content from "@arnaud-zg/design/Content.astro";
import LinkCard from "@arnaud-zg/design/LinkCard.astro";
import Command from "@arnaud-zg/design/Command.astro";
import Icon from "@arnaud-zg/design/Icon.astro";
import ThemeSwitch from "@arnaud-zg/design/ThemeSwitch.astro";
import Rich from "@arnaud-zg/design/Rich.astro";
import Avatar from "@arnaud-zg/design/Avatar.astro";
import Intro from "@arnaud-zg/design/Intro.astro";
import SectionHead from "@arnaud-zg/design/SectionHead.astro";
import Kpis from "@arnaud-zg/design/Kpis.astro";
import Numbers from "@arnaud-zg/design/Numbers.astro";
import Tags from "@arnaud-zg/design/Tags.astro";
import Pill from "@arnaud-zg/design/Pill.astro";
import Ask from "@arnaud-zg/design/Ask.astro";
import Dialog from "@arnaud-zg/design/Dialog.astro";
import { portrait, siteInfo } from "../../site";
import Story from "../../components/Story.astro";
import { frames, starlightFrames } from "../../design/stories";
import config from "../../../portfolio.config";
import "../../styles/workshop.css";

const levels = ["Tokens", "Atoms", "Molecules", "Organisms", "Templates", "Starlight"];
const id = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const nav = levels.map((l) => ({ href: `#${id(l)}`, label: l }));
const colors = [["--bg", "Page"], ["--bg-deep", "Page, end of the gradient"], ["--surface", "Card"], ["--surface-hi", "Card, raised"], ["--ink", "Text"], ["--ink-lo", "Secondary text"], ["--line", "Hairline"], ["--accent", "Accent"], ["--accent-soft", "Accent, tint"]];
const type = [["--fs-h2", "Section title", 300], ["--fs-h3", "Card title", 400], ["--fs-body", "Body text", 400], ["--fs-small", "Secondary text", 400], ["--fs-label", "Label", 400]] as const;
const spaces = [["--edge", "Page edge"], ["--section", "Between sections"], ["--head", "Under a section head"], ["--radius", "Corner"]];
const preview = (level: string) => frames.filter((f) => f.level === level).map((f) => ({ ...f, src: `${import.meta.env.BASE_URL}design/preview/${f.id}/` }));
const framed = [
  { level: "Organisms", lede: "Whole regions of a page, each in its own frame.", items: preview("Organisms") },
  { level: "Templates", lede: "Custom pages, for anything that is not documentation.", items: preview("Templates") },
  { level: "Starlight", lede: "Documentation sites. Search, sidebar and Markdown are Starlight's; the look is this design, through one plugin.", items: starlightFrames.map((f) => ({ ...f, src: `${import.meta.env.BASE_URL}design/starlight/${f.id}/` })) },
];
const icons = ["github", "linkedin", "substack", "star", "arrow", "pr", "bird"] as const;
---
<Site site={siteInfo} title={`Design workshop · ${config.site.brand}`} description="The parts this site and its sub-sites are built from." nav={nav} noindex>
  <Hero site={siteInfo} title="Design workshop" tagline="You found the door. These are the parts every site here is built from, live." />
  <Content>
    <div class="workshop">
      <aside class="ws-nav">
        <nav aria-label="Parts">
          {levels.map((l) => <a href={`#${id(l)}`}>{l}</a>)}
          <hr />
          <a href={import.meta.env.BASE_URL}>Back to the portfolio</a>
        </nav>
      </aside>
      <div class="ws-main">
        <section id="tokens" class="ws-level">
          <SectionHead title="Tokens" lede="Named values. Switch day and night in the header and they all follow." />
          <Story name="Colour" use="One accent. Everything else is ink and paper." code="color: var(--accent);">
            <ul class="ws-colors">{colors.map(([t, l]) => <li><span style={`background:var(${t})`}></span><b>{l}</b><code>{t}</code></li>)}</ul>
          </Story>
          <Story name="Type" use="M PLUS 1 for words, M PLUS 1 Code for labels and code." code="font-size: var(--fs-h2);">
            <ul class="ws-type">{type.map(([t, l, weight]) => <li><span class:list={[t === "--fs-label" && "label"]} style={`font-size:var(${t});font-weight:${weight}`}>{l}</span><code>{t}</code></li>)}</ul>
          </Story>
          <Story name="Space and shape" use="One rhythm, fluid with the screen." code="padding-inline: var(--edge);">
            <ul class="ws-spaces">{spaces.map(([t, l]) => <li><span style={`width:var(${t})`}></span><b>{l}</b><code>{t}</code></li>)}</ul>
          </Story>
          <Story name="Motion" use="Out for what appears, move for what travels. Point at the lane." code="transition: translate 600ms var(--ease-out);">
            <ul class="ws-motion">{["--ease-out", "--ease-move"].map((t) => <li tabindex="0"><span style={`transition-timing-function:var(${t})`}></span><code>{t}</code></li>)}</ul>
          </Story>
        </section>

        <section id="atoms" class="ws-level">
          <SectionHead title="Atoms" lede="The smallest parts, with no layout of their own." />
          <Story name="Icon" use="Drawn, one colour, inherits the text's." code={'<Icon name="github" size={20} />'}>
            <ul class="ws-icons">{icons.map((n) => <li><Icon name={n} size={22} /><code>{n}</code></li>)}</ul>
          </Story>
          <Story name="ThemeSwitch" use="Remembers the choice for every site on this origin." code="<ThemeSwitch />"><div class="ws-on-photo"><ThemeSwitch /></div></Story>
          <Story name="Avatar" use="A portrait, square with the shared corner." code={'<Avatar src={photo} alt="…" />'}><Avatar {...portrait} /></Story>
          <Story name="Tags" use="Short facts, read together." code={'<Tags items={["TypeScript", "Astro"]} label="Stack" />'}><Tags items={["TypeScript", "Astro"]} label="Stack" /></Story>
          <Story name="Pill" use="A quiet action." code={'<Pill opens="my-dialog">3 more projects</Pill>'}><div class="pills"><Pill opens="ws-dialog">Open the dialog</Pill><Pill plain aria-pressed="true">Chosen</Pill><Pill plain aria-pressed="false">Not chosen</Pill></div></Story>
          <Story name="Rich" use="Marks the words that matter. Two or three per text." code={'<Rich text="Now I build **tools**." />'}><p><Rich text="Now I build **tools other engineers rely on**." /></p></Story>
          <Story name="Link and label" use="Links in running text, labels on data." code={'<a class="inline" href="…">…</a>  <span class="label">…</span>'}><p class="ws-row"><a class="inline" href="#atoms">An inline link</a><span class="label">A label</span></p></Story>
        </section>

        <section id="molecules" class="ws-level">
          <SectionHead title="Molecules" lede="Atoms that do one job together." />
          <Story name="LinkCard" use="A card that is one link. Leaving the origin opens a new tab." code={'<LinkCard href="/js-packages/shiplane/" name="shiplane" text="…" />'}>
            <ul class="card-grid"><li><LinkCard href="#molecules" name="shiplane" text="Stays on this site: the page transition runs" /></li><li><LinkCard href={config.links[0].href} name={config.links[0].label} text="Leaves this site: a new tab opens" /></li></ul>
          </Story>
          <Story name="SectionHead" use="Title, lede, then figures." code={'<SectionHead title="Packages" lede="…" />'}><SectionHead title="Packages" lede="Each card opens its own page." /></Story>
          <Story name="Intro" use="Who is speaking, then what they say. The portrait is optional." code={'<Intro title="Hi" lede="…" portrait={{ src, alt }} />'}><Intro title={config.sections.about.title} lede={config.sections.about.lede} portrait={portrait} /></Story>
          <Story name="Kpis" use="One line of figures, real ones only." code={'<Kpis items={[{ value: 84, label: "releases" }]} />'}><Kpis items={[{ value: 84, label: "releases" }, { value: "+120", label: "lines added", tone: "added" }, { value: "−30", label: "lines removed", tone: "removed" }]} /></Story>
          <Story name="Numbers" use="The figures a page opens on." code={'<Numbers items={[{ value: 13, unit: "years", label: "…" }]} />'}><Numbers items={[{ value: 13, unit: "years", label: "shipping software" }, { value: 9, unit: "tools", label: "open source" }]} /></Story>
          <Story name="Dialog" use="For detail that would crowd the page." code={'<Dialog id="my-dialog" title="More">…</Dialog>'}><Pill opens="ws-dialog">Open the dialog</Pill><Dialog id="ws-dialog" title="A dialog"><p>Escape, the close button or a click outside closes it.</p></Dialog></Story>
          <Story name="Ask" use="A question the page can do without. Corner of the screen, never over the page; both answers weigh the same." code={'<Ask title="…" text="…"><Pill plain>Yes</Pill><Pill plain>No</Pill></Ask>'}><div class="pills"><Pill plain data-show-ask>Show it</Pill></div><Ask title="May I ask?" text="Either answer is fine, and the page stays the same." data-ws-ask><Pill plain data-hide-ask>Yes</Pill><Pill plain data-hide-ask>No</Pill></Ask></Story>
          <Story name="Command" use="One command to copy." code={'<Command label="Install" command="pnpm add -D shiplane" />'}><Command label="Install" command={config.skills.install} /></Story>
        </section>

        {framed.map(({ level, lede, items }) => (
          <section id={id(level)} class="ws-level">
            <SectionHead title={level} lede={lede} />
            {items.map((f) => (
              <Story name={f.name} use={f.use} code={f.code}>
                <div class="ws-frame" data-frame>
                  <div class="ws-sizes" role="group" aria-label={`${f.name}: preview width`}>
                    {[["390px", "Phone"], ["768px", "Tablet"], ["100%", "Full"]].map(([v, l]) => <button type="button" data-width={v} aria-pressed={v === "100%" ? "true" : "false"}>{l}</button>)}
                    <a class="inline" href={f.src} target="_blank" rel="noopener">Open alone</a>
                  </div>
                  <iframe src={f.src} title={`${f.name} preview`} loading="lazy" height={f.height}></iframe>
                </div>
              </Story>
            ))}
          </section>
        ))}
      </div>
    </div>
  </Content>
</Site>

<script>
  const ask = document.querySelector<HTMLElement>("[data-ws-ask]")!;
  document.querySelector("[data-show-ask]")!.addEventListener("click", () => { ask.hidden = false; });
  document.querySelectorAll("[data-hide-ask]").forEach((b) => b.addEventListener("click", () => { ask.hidden = true; }));
  document.querySelectorAll<HTMLElement>("[data-frame]").forEach((box) => {
    const frame = box.querySelector("iframe")!;
    const buttons = [...box.querySelectorAll<HTMLButtonElement>("[data-width]")];
    buttons.forEach((b) => b.addEventListener("click", () => {
      frame.style.width = b.dataset.width!;
      buttons.forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
    }));
  });
</script>
