---
import Site from "@arnaud-zg/design/Site.astro";
import Hero from "@arnaud-zg/design/Hero.astro";
import Content from "@arnaud-zg/design/Content.astro";
import LinkCard from "@arnaud-zg/design/LinkCard.astro";
import Command from "@arnaud-zg/design/Command.astro";
import Icon from "@arnaud-zg/design/Icon.astro";
import ThemeSwitch from "@arnaud-zg/design/ThemeSwitch.astro";
import Rich from "@arnaud-zg/design/Rich.astro";
import Avatar from "@arnaud-zg/design/Avatar.astro";
import Intro from "@arnaud-zg/design/Intro.astro";
import SectionHead from "@arnaud-zg/design/SectionHead.astro";
import Kpis from "@arnaud-zg/design/Kpis.astro";
import Numbers from "@arnaud-zg/design/Numbers.astro";
import Tags from "@arnaud-zg/design/Tags.astro";
import Pill from "@arnaud-zg/design/Pill.astro";
import Ask from "@arnaud-zg/design/Ask.astro";
import Dialog from "@arnaud-zg/design/Dialog.astro";
import Markdown from "@arnaud-zg/design/Markdown.astro";
import Facts from "@arnaud-zg/design/Facts.astro";
import Roles from "@arnaud-zg/design/Roles.astro";
import Stints from "@arnaud-zg/design/Stints.astro";
import Education from "@arnaud-zg/design/Education.astro";
import Treemap from "@arnaud-zg/design/Treemap.astro";
import Shelf from "@arnaud-zg/design/Shelf.astro";
import Articles from "@arnaud-zg/design/Articles.astro";
import Diffstat from "@arnaud-zg/design/Diffstat.astro";
import Activity from "@arnaud-zg/design/Activity.astro";
import SecretBird from "@arnaud-zg/design/SecretBird.astro";
import Pills from "@arnaud-zg/design/Pills.astro";
import Section from "@arnaud-zg/design/Section.astro";
import Segmented from "@arnaud-zg/design/Segmented.astro";
import { heroVariants } from "@arnaud-zg/design/Hero.variants";
import { pillVariants } from "@arnaud-zg/design/Pill.variants";
import { dialogVariants } from "@arnaud-zg/design/Dialog.variants";
import { sectionVariants } from "@arnaud-zg/design/Section.variants";
import CardGrid from "@arnaud-zg/design/CardGrid.astro";
import { squarify, TREEMAP_BOX } from "@arnaud-zg/design/treemap";
import { portrait, siteInfo } from "../../site";
import Story from "../../components/Story.astro";
import { frames, starlightFrames } from "../../design/stories";
import config from "../../../portfolio.config";
import "../../styles/workshop.css";

const levels = ["Tokens", "Atoms", "Molecules", "Sections", "Organisms", "Templates", "Starlight"];
const id = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const nav = levels.map((l) => ({ href: `#${id(l)}`, label: l }));
const colors = [["--bg", "Page"], ["--bg-deep", "Page, end of the gradient"], ["--surface", "Card"], ["--surface-hi", "Card, raised"], ["--ink", "Text"], ["--ink-lo", "Secondary text"], ["--line", "Hairline"], ["--accent", "Accent"], ["--accent-soft", "Accent, tint"]];
const type = [["--fs-h2", "Section title", 300], ["--fs-h3", "Card title", 400], ["--fs-body", "Body text", 400], ["--fs-small", "Secondary text", 400], ["--fs-label", "Label", 400]] as const;
const spaces = [["--edge", "Page edge"], ["--section", "Between sections"], ["--head", "Under a section head"], ["--radius", "Corner"]];
const src = (frame: string) => `${import.meta.env.BASE_URL}design/preview/${frame}/`;
type Framed = { id: string; name: string; use: string; code: string; height: number; src: string; sizes?: { value: string; src: string; height: number }[] };
// The hero's sizes open in frames of their own; on show, they are one story with a size control.
const preview = (level: string): Framed[] => {
  const list: Framed[] = frames.filter((f) => f.level === level).map((f) => ({ ...f, src: src(f.id) }));
  const heroes = list.filter((f) => f.id.startsWith("hero-"));
  if (!heroes.length) return list;
  const sizes = heroVariants.axes.size.map((value) => {
    const f = heroes.find((h) => h.id === `hero-${value}`)!;
    return { value, src: f.src, height: f.height };
  });
  const first = sizes[0];
  const hero = { id: "hero", name: "Hero", use: "The photo at the top of a page. Full is the front door of the portfolio, one per origin; banner is the short photo of its inner pages. Sub-sites have no hero.", code: '<Hero site={site}{variants} title="…" tagline="…" />', height: first.height, src: first.src, sizes };
  return list.flatMap((f): Framed[] => (f === heroes[0] ? [hero] : f.id.startsWith("hero-") ? [] : [f]));
};
const framed: { level: string; lede: string; items: Framed[] }[] = [
  { level: "Organisms", lede: "Whole regions of a page, each in its own frame.", items: preview("Organisms") },
  { level: "Templates", lede: "Custom pages, for anything that is not documentation.", items: preview("Templates") },
  { level: "Starlight", lede: "Documentation sites. Search, sidebar and Markdown are Starlight's; the look is this design, through one plugin.", items: starlightFrames.map((f) => ({ ...f, src: `${import.meta.env.BASE_URL}design/starlight/${f.id}/` })) },
];
// One made-up tool per tile, laid out as a site would.
const tool = (name: string, releases: number, members = 1) => ({ name, releases, members, line: "What the tool does", href: "https://www.npmjs.com", monthlyReleases: 2, downloads: releases * 100, month: "October 2026" });
const tiles = [[tool("release-kit", 26, 4), tool("lint-kit", 18)], [tool("test-kit", 20, 2)]];
const total = (group: { releases: number }[]) => group.reduce((n, t) => n + t.releases, 0);
const [boxes, ...inner] = [tiles.map(total), ...tiles.map((g) => g.map((t) => t.releases))].map((v) => squarify(v, TREEMAP_BOX.w, TREEMAP_BOX.h, true));
const groups = tiles.map((g, gi) => ({ name: ["Shipping", "Testing"][gi], emoji: ["🚢", "🧪"][gi], rect: boxes[gi], tiles: g.map((t, ti) => ({ tool: t, releases: t.releases, weight: t.releases, recent: ti === 0, rect: inner[gi][ti], mrect: inner[gi][ti] })) }));
const diffs = [["acme/bundler", 420, 80], ["acme/cli", 120, 60], ["acme/docs", 20, 5]].map(([repo, added, removed]) => ({ repo: String(repo), about: "What the project is", kinds: "2 fixes", added: Number(added), removed: Number(removed), href: "https://github.com" }));
const thread = (status: "merged" | "review", title: string, reported?: string) => ({ status, title, href: "https://github.com", reported: reported ? [{ number: reported, href: "https://github.com" }] : undefined });
const activity = [
  { repo: "acme/bundler", about: "What the project is", href: "https://github.com", years: "2026", prs: "3 PRs", added: 139, removed: 27, pending: { added: 46, removed: 8 }, threads: [thread("review", "Keep the whole range"), thread("merged", "Match short ranges at runtime", "120"), thread("merged", "Skip internal entries")] },
  { repo: "acme/dates", about: "What the project is", href: "https://github.com", years: "2026", prs: "1 PR", added: 0, removed: 0, pending: { added: 18, removed: 3 }, threads: [thread("review", "Reject dates that do not exist")] },
  { repo: "acme/popup", about: "An older project, its pull requests listed all the same", href: "https://github.com", years: "2019–2020", prs: "2 PRs", added: 102, removed: 61, threads: [thread("merged", "Call onClose when the popup closes"), thread("merged", "Wait for a frame, not an interval")] },
  { repo: "acme/tiny", about: "Smaller than the first two, still on the page", href: "https://github.com", years: "2019", prs: "1 PR", added: 14, removed: 2, threads: [thread("merged", "Fix a type")] },
  { repo: "acme/types", about: "Small, with more than its row shows: its own dialog opens from the dialog", href: "https://github.com", years: "2019–2021", prs: "3 PRs", added: 9, removed: 3, threads: [thread("merged", "Type the picker's props"), thread("merged", "Export the event type"), thread("merged", "Allow a null value")] },
];
const icons = ["github", "linkedin", "substack", "star", "arrow", "pr", "bird"] as const;
---
<Site site={siteInfo} title={`Design workshop · ${config.site.brand}`} description="The parts this site and its sub-sites are built from." nav={nav} noindex>
  <Hero site={siteInfo} title="Design workshop" tagline="You found the door. These are the parts every site here is built from, live." />
  <Content>
    <div class="workshop">
      <aside class="ws-nav">
        <nav aria-label="Parts">
          {levels.map((l) => <a href={`#${id(l)}`}>{l}</a>)}
          <hr />
          <a href={import.meta.env.BASE_URL}>Back to the portfolio</a>
        </nav>
      </aside>
      <div class="ws-main">
        <section id="tokens" class="ws-level">
          <SectionHead title="Tokens" lede="Named values. Switch day and night in the header and they all follow." />
          <Story name="Colour" use="One accent. Everything else is ink and paper." code="color: var(--accent);">
            <ul class="ws-colors">{colors.map(([t, l]) => <li><span style={`background:var(${t})`}></span><b>{l}</b><code>{t}</code></li>)}</ul>
          </Story>
          <Story name="Type" use="M PLUS 1 for words, M PLUS 1 Code for labels and code." code="font-size: var(--fs-h2);">
            <ul class="ws-type">{type.map(([t, l, weight]) => <li><span class:list={[t === "--fs-label" && "label"]} style={`font-size:var(${t});font-weight:${weight}`}>{l}</span><code>{t}</code></li>)}</ul>
          </Story>
          <Story name="Space and shape" use="One rhythm, fluid with the screen." code="padding-inline: var(--edge);">
            <ul class="ws-spaces">{spaces.map(([t, l]) => <li><span style={`width:var(${t})`}></span><b>{l}</b><code>{t}</code></li>)}</ul>
          </Story>
          <Story name="Motion" use="Out for what appears, in for what leaves, move for what travels; each with its duration. Point at the lane." code="transition: opacity var(--dur-enter) var(--ease-out);">
            <ul class="ws-motion">{[["--ease-out", "--dur-enter"], ["--ease-in", "--dur-leave"], ["--ease-move", "--dur-move"]].map(([e, d]) => <li tabindex="0"><span style={`transition-timing-function:var(${e});transition-duration:var(${d})`}></span><code>{e} · {d}</code></li>)}</ul>
          </Story>
        </section>

        <section id="atoms" class="ws-level">
          <SectionHead title="Atoms" lede="The smallest parts, with no layout of their own." />
          <Story name="Icon" use="Drawn, one colour, inherits the text's." code={'<Icon name="github" size={20} />'}>
            <ul class="ws-icons">{icons.map((n) => <li><Icon name={n} size={22} /><code>{n}</code></li>)}</ul>
          </Story>
          <Story name="ThemeSwitch" use="Remembers the choice for every site on this origin." code="<ThemeSwitch />"><div class="ws-on-photo"><ThemeSwitch /></div></Story>
          <Story name="Avatar" use="A portrait, square with the shared corner." code={'<Avatar src={photo} alt="…" />'}><Avatar {...portrait} /></Story>
          <Story name="Tags" use="Short facts, read together." code={'<Tags items={["TypeScript", "Astro"]} label="Stack" />'}><Tags items={["TypeScript", "Astro"]} label="Stack" /></Story>
          <Story name="Pill" use="A quiet action. Arrow leads somewhere, plain answers or chooses, quiet is for what few look for." code={'<Pill{variants} opens="my-dialog">3 more projects</Pill>'} variants={pillVariants}>{(v: { look: "arrow" | "plain" | "quiet" }) => <Pills><Pill look={v.look} opens={v.look === "plain" ? undefined : "ws-dialog"} aria-pressed={v.look === "plain" ? "true" : undefined}>{v.look === "plain" ? "Chosen" : v.look === "quiet" ? "Privacy" : "Open the dialog"}</Pill></Pills>}</Story>
          <Story name="Rich" use="Marks the words that matter. Two or three per text." code={'<Rich text="Now I build **tools**." />'}><p><Rich text="Now I build **tools other engineers rely on**." /></p></Story>
          <Story name="Version" use="Never on the page: in the head, and in the console. Open it to see." code={'<Version site={site} />'}><p class="label">v{siteInfo.version}</p></Story>
          <Story name="Link and label" use="Links in running text, labels on data." code={'<a class="inline" href="…">…</a>  <span class="label">…</span>'}><p class="ws-row"><a class="inline" href="#atoms">An inline link</a><span class="label">A label</span></p></Story>
        </section>

        <section id="molecules" class="ws-level">
          <SectionHead title="Molecules" lede="Atoms that do one job together." />
          <Story name="LinkCard" use="A card that is one link. Leaving the origin opens a new tab." code={'<LinkCard href="/js-packages/shiplane/" name="shiplane" text="…" />'}>
            <CardGrid><li><LinkCard href="#molecules" name="shiplane" text="Stays on this site: the page transition runs" /></li><li><LinkCard href={config.links[0].href} name={config.links[0].label} text="Leaves this site: a new tab opens" /></li><li><LinkCard href={config.links[0].href} name="/a-skill" text="Opens a dialog; its corner arrow is the link" opens="ws-md" openLabel="a-skill: why it works" linkLabel="a-skill on GitHub" /></li></CardGrid>
          </Story>
          <Story name="SectionHead" use="Title, lede, then figures." code={'<SectionHead title="Packages" lede="…" />'}><SectionHead title="Packages" lede="Each card opens its own page." /></Story>
          <Story name="Section" use="A band of the page, as wide as the content. Tight sits closer to what is above it: a strip of figures, or the first section under a banner." code={'<Section id="about"{variants} labelledby="about-title">…</Section>'} variants={sectionVariants}>{(v: { space: "default" | "tight" }) => <Section space={v.space}><SectionHead title="A section" lede="Its head, then its parts." /></Section>}</Story>
          <Story name="Intro" use="Who is speaking, then what they say. The portrait is optional." code={'<Intro title="Hi" lede="…" portrait={{ src, alt }} />'}><Intro title={config.sections.about.title} lede={config.sections.about.lede} portrait={portrait} /></Story>
          <Story name="Kpis" use="One line of figures, real ones only. A caption names a period once, for the figures after it." code={'<Kpis items={[{ value: 84, label: "releases" }, { label: "In October 2026", caption: true }, …]} />'}><Kpis items={[{ value: 6, label: "tools" }, { label: "In October 2026", caption: true }, { value: 2, label: "releases" }, { value: "1.2k", label: "npm downloads" }]} /><Kpis items={[{ value: 84, label: "releases" }, { value: "+120", label: "lines added", tone: "added" }, { value: "−30", label: "lines removed", tone: "removed" }]} /></Story>
          <Story name="Numbers" use="The figures a page opens on." code={'<Numbers items={[{ value: 13, unit: "years", label: "…" }]} />'}><Numbers items={[{ value: 13, unit: "years", label: "shipping software" }, { value: 9, unit: "tools", label: "open source" }]} /></Story>
          <Story name="Markdown" use="Markdown rendered at build time as running text. Relative links resolve against base; a mermaid block becomes its diagram, drawn when first seen, in the page's theme." code={'<Markdown source={markdown} base="https://github.com/…/README.md" />'}><Pill opens="ws-md">Open a document</Pill><Dialog id="ws-md" title="/a-skill" lede="Why it works" size="narrow"><Markdown source={"## A part\n\nText with a [relative link](how-to.md) and `code`.\n\n```mermaid\nflowchart LR\n  A[read] --> B[decide] --> C[ship]\n```\n\nA wide one shows at a readable size and scrolls; its button fits it whole.\n\n```mermaid\nflowchart LR\n  classDef copy fill:#e3f3df,stroke:#2f7d32,color:#0f2a10\n  A[a request arrives] --> B[the description matches] --> C[the entry routes it] --> D[one page is read] --> E[a script checks it] --> F[the answer ships]:::copy\n```\n\n- One point\n- Another"} base="https://github.com/arnaud-zg/skills/blob/HEAD/README.md" /><Pill slot="foot" href="https://github.com/arnaud-zg/skills">Open the project</Pill></Dialog></Story>
          <Story name="Dialog" use="For detail that would crowd the page. Wide holds a table or a grid, narrow one list read top to bottom. It scrolls inside." code={'<Dialog{variants} id="my-dialog" title="More">…</Dialog>'} variants={dialogVariants}>{(v: { size: "wide" | "narrow" }) => v.size === "wide" ? <><Pill opens="ws-dialog">Open the dialog</Pill><Dialog id="ws-dialog" title="A dialog"><p>Escape, the close button or a click outside closes it.</p></Dialog></> : <><Pill opens="ws-dialog-narrow">Open the narrow dialog</Pill><Dialog id="ws-dialog-narrow" size="narrow" title="A narrow dialog"><p>One list, read top to bottom.</p></Dialog></>}</Story>
          <Story name="Ask" use="A question the page can do without. Corner of the screen, never over the page; both answers weigh the same." code={'<Ask title="…" text="…"><Pill look="plain">Yes</Pill><Pill look="plain">No</Pill></Ask>'}><div class="pills"><Pill look="plain" data-show-ask>Show it</Pill></div><Ask title="May I ask?" text="Either answer is fine, and the page stays the same." data-ws-ask><Pill look="plain" data-hide-ask>Yes</Pill><Pill look="plain" data-hide-ask>No</Pill></Ask></Story>
          <Story name="Command" use="One command to copy." code={'<Command label="Install" command="pnpm add -D shiplane" />'}><Command label="Install" command={config.skills.install} /></Story>
          <Story name="Facts" use="What a reader looks for first, side by side." code={'<Facts items={[{ label: "Now", value: "Engineer", note: "at Acme" }]} />'}><Facts items={[{ label: "Now", value: "Engineer", note: "at Acme" }, { label: "Experience", value: "9 years" }]} /></Story>
          <Story name="Stints" use="Short jobs folded into one line. Open it and press a company: its emoji travels from the name to the year, in the motion of its domain." code={'<Stints title="School" years="2013–2016" role="Intern" stints={[{ company, year, note, emoji: "🧪", motion: "fizz", since, until }]} />'}><Stints title="School" years="2013–2016" role="Intern" stints={[{ company: "Acme", year: "2014", note: "Testing: a flask, shaken", emoji: "🧪", motion: "fizz", since: "2014-01", until: "2014-06" }, { company: "Initech", year: "2014", note: "Sport: a ball, kicked", emoji: "⚽", motion: "bounce", since: "2014-01", until: "2014-06" }, { company: "Hooli", year: "2014", note: "Lighting: a bulb, switched on", emoji: "💡", motion: "beam", since: "2014-01", until: "2014-06" }, { company: "Umbrella", year: "2014", note: "Abroad: a lantern, drifting", emoji: "🏮", motion: "float", since: "2014-01", until: "2014-06" }, { company: "Vandelay", year: "2014", note: "Shopping: a cart, rolling", emoji: "🛒", motion: "roll", since: "2014-01", until: "2014-06" }, { company: "Wonka", year: "2013", note: "Agency: a sparkle, signing with a flourish", emoji: "✨", motion: "flourish", since: "2013-07", until: "2013-12" }, { company: "Cyberdyne", year: "2015", note: "R&D: a gear, stepping on a bench", emoji: "⚙️", motion: "gear", since: "2015-03", until: "2015-08" }, { company: "Globex", year: "2013", note: "Without an emoji, a plain name" }]} /></Story>
          <Story name="Shelf" use="Older work, folded away. Each card is a plain link." code={'<Shelf emoji="🗃️" title="See 2 earlier libraries" items={items} />'}><Shelf emoji="🗃️" title="See 2 earlier libraries" items={["old-kit", "older-kit"].map((n) => ({ name: n, line: "What it did", href: "https://www.npmjs.com", year: "2020", label: `${n} on npm` }))} /></Story>
          <Story name="SecretBird" use="A quiet way in, at the end of a page." code={'<SecretBird href="/design/" label="Design workshop" />'}><SecretBird href="#molecules" label="Molecules" /></Story>
        </section>

        <section id="sections" class="ws-level">
          <SectionHead title="Sections" lede="Whole sections of a page. Give them data; they bring their styles and behaviour." />
          <Story name="Roles" use="One card per job, newest first. Press a company with an emoji: it travels from the name to the dates in the motion of its domain (glide, ticket, concert, drive, pay, pulse…), slower the longer the stay." code={'<Roles roles={[{ company: "Acme", emoji: "🩺", motion: "pulse", since: "2022-01", … }]} labels={{ then: "then", stack: "Stack" }} />'}><Roles labels={{ then: "then", stack: "Stack" }} roles={[{ company: "Acme", industry: "Health", emoji: "🩺", motion: "pulse", since: "2022-01", titles: [{ title: "Engineer" }, { title: "Senior engineer", since: "2024" }], dates: "2022 → now", now: true, highlights: ["Something shipped, plain and specific"], stack: ["TypeScript"] }, { company: "Globex", industry: "Payroll", emoji: "💸", motion: "pay", since: "2016-01", until: "2021-12", titles: [{ title: "Engineer" }], dates: "2016 → 2021", now: false, highlights: ["Six years: the slowest journey"], stack: ["TypeScript"] }, { company: "Initech", industry: "Tickets", emoji: "🎟️", motion: "ticket", since: "2014-01", until: "2015-12", titles: [{ title: "Engineer" }], dates: "2014 → 2015", now: false, highlights: ["A slip of paper on the air"], stack: ["React"] }, { company: "Soylent", industry: "Concerts", emoji: "🎟️", motion: "concert", since: "2017-03", until: "2019-05", titles: [{ title: "Engineer" }], dates: "2017 → 2019", now: false, highlights: ["Jumps with the crowd, then confetti"], stack: ["React"] }, { company: "Hooli", industry: "Mobility", emoji: "🚗", motion: "drive", since: "2013-06", until: "2013-12", titles: [{ title: "Engineer" }], dates: "2013", now: false, highlights: ["Six months: the quickest, still unhurried"], stack: ["React Native"] }]} /></Story>
          <Story name="Education" use="Compact cards, newest first. Press a school with an emoji: it travels from the name to the years, a stair of years then a cap thrown (climb), or a long-haul flight (voyage)." code={'<Education title="Education" items={[{ school, emoji: "🎓", motion: "climb", start, end, … }]} labels={{ skills: "Skills" }} />'}><Education title="Education" labels={{ skills: "Skills" }} items={[{ school: "A school", emoji: "🎓", motion: "climb", degree: "A degree", start: "2013", end: "2016", highlights: ["What it was about"], skills: ["Algorithms"] }, { school: "Abroad", emoji: "🌏", motion: "voyage", degree: "An exchange", start: "2015", end: "2017", highlights: ["A long-haul flight"] }]} /></Story>
          <Story name="Treemap" use="Tools by group, sized by weight. Open one: the rest glides aside and its card rises, sized to its figures. A list on small screens." code={'<Treemap groups={groups} labels={labels} />'}><Treemap groups={groups} labels={config.labels} /></Story>
          <Story name="Articles" use="Covers in a row, newest first." code={'<Articles items={articles} />'}><Articles items={[2, 1].map((n) => ({ title: `Article ${n}`, url: config.links[0].href, date: `2026-0${n}-01`, dateText: `0${n}/2026`, image: portrait.src }))} /></Story>
          <Story name="Activity" use="The record by repository, largest first: years, pull requests and lines merged, as a bar against the largest, the lines in review dotted after it. Each row shows its two latest pull requests (filled dot: merged, hollow: in review); more open in the repository's dialog. The smaller repositories open in one dialog, as the same rows with the figures on the right and the bar below, each opening its own on top." code={'<Activity id="oss" items={repos} top={3} labels={labels} />'}><Activity id="ws-act" items={activity} top={3} labels={{ merged: "merged", review: "in review", reported: (n) => `reported it first (#${n})`, details: (n) => `All ${n} pull requests`, more: (n) => `See ${n} smaller contributions`, moreTitle: "Smaller contributions", onGitHub: "Pull requests on GitHub" }} /></Story>
          <Story name="Diffstat" use="Contributions by repository, largest first. The rest open in a dialog." code={'<Diffstat id="more" items={repos} top={2} labels={labels} />'}><Diffstat id="ws-diff" items={diffs} top={2} labels={{ added: "added", removed: "removed", more: (n) => `${n} more`, moreTitle: "More projects" }} /></Story>
        </section>

        {framed.map(({ level, lede, items }) => (
          <section id={id(level)} class="ws-level">
            <SectionHead title={level} lede={lede} />
            {items.map((f) => (
              <Story name={f.name} use={f.use} code={f.code} framed>
                <div class="ws-frame" data-frame data-sizes={f.sizes && JSON.stringify(f.sizes)}>
                  <div class="ws-sizes">
                    {f.sizes && <Segmented label={`${f.name}: size`} name="size" options={f.sizes.map((z) => z.value)} value={f.sizes[0].value} />}
                    <Segmented label={`${f.name}: preview width`} name="width" options={[{ value: "390px", label: "Phone" }, { value: "768px", label: "Tablet" }, { value: "100%", label: "Full" }]} value="100%" />
                    <a class="inline" href={f.src} target="_blank" rel="noopener" data-open-alone>Open alone</a>
                  </div>
                  <iframe src={f.src} title={`${f.name} preview`} loading="lazy" height={f.height}></iframe>
                </div>
              </Story>
            ))}
          </section>
        ))}
      </div>
    </div>
  </Content>
</Site>

<script>
  const ask = document.querySelector<HTMLElement>("[data-ws-ask]")!;
  document.querySelector("[data-show-ask]")!.addEventListener("click", () => { ask.hidden = false; });
  document.querySelectorAll("[data-hide-ask]").forEach((b) => b.addEventListener("click", () => { ask.hidden = true; }));
  // Framed parts: the width of the frame, and for the hero which size it shows.
  document.querySelectorAll<HTMLElement>("[data-frame]").forEach((box) => {
    const frame = box.querySelector("iframe")!;
    const alone = box.querySelector<HTMLAnchorElement>("[data-open-alone]")!;
    const code = box.closest(".story")?.querySelector<HTMLElement>("[data-code]");
    const sizes: { value: string; src: string; height: number }[] = box.dataset.sizes ? JSON.parse(box.dataset.sizes) : [];
    box.addEventListener("segmented", (e) => {
      const { name, value } = (e as CustomEvent<{ name: string; value: string }>).detail;
      if (name === "width") frame.style.width = value;
      const size = sizes.find((z) => z.value === value);
      if (name === "size" && size) {
        frame.src = alone.href = size.src;
        frame.height = String(size.height);
        if (code) code.textContent = code.dataset.code!.replace("{variants}", size === sizes[0] ? "" : ` size="${value}"`);
      }
    });
  });
</script>
