---
import Site from "@arnaud-zg/design/Site.astro";
import Hero from "@arnaud-zg/design/Hero.astro";
import Content from "@arnaud-zg/design/Content.astro";
import Section from "@arnaud-zg/design/Section.astro";
import SectionHead from "@arnaud-zg/design/SectionHead.astro";
import CardGrid from "@arnaud-zg/design/CardGrid.astro";
import Prose from "@arnaud-zg/design/Prose.astro";
import Socials from "@arnaud-zg/design/Socials.astro";
import Page from "@arnaud-zg/design/Page.astro";
import PageHead from "@arnaud-zg/design/PageHead.astro";
import LinkCard from "@arnaud-zg/design/LinkCard.astro";
import Command from "@arnaud-zg/design/Command.astro";
import Ending from "@arnaud-zg/design/Ending.astro";
import config from "../../../../portfolio.config";
import { siteInfo } from "../../../site";
import { frames } from "../../../design/stories";

export const getStaticPaths = () => frames.map((f) => ({ params: { story: f.id }, props: { name: f.name } }));
const { story } = Astro.params;
const { links, sections } = config;
const nav = [{ href: "#packages", label: "Packages" }, { href: "#contact", label: "Contact" }];
const line = "Small, focused TypeScript tools for monorepos.";
const kind = story;
const isTemplate = kind === "home" || kind === "page";
const sub = { ...siteInfo, id: "js-packages" };
const shell = { site: sub, title: `${Astro.props.name} · Design workshop`, description: "A part of the shared design, on its own.", nav, noindex: true };
---
{isTemplate ? (
  <Page {...shell} heading={kind === "home" ? "js-packages" : "shiplane"} tagline={line}>
    {kind === "home" ? (
      <Section id="packages" space="tight">
        <SectionHead title="Packages" lede="Each card opens its own page." />
        <CardGrid>
          {[["shiplane", "Release and deploy a monorepo in one command"], ["expo-native-guard", "Load native-only modules safely in Expo Go"], ["agent-context-budget", "Scores the markdown files an AI agent loads"]].map(([n, t]) => <li><LinkCard href="#packages" name={n} text={t} /></li>)}
        </CardGrid>
      </Section>
    ) : (
      <Section as="article" space="tight">
        <Command label="Install" command="pnpm add -D shiplane" />
        <Prose><h2>When you need it</h2><p>Releasing several apps from one repo is a pile of scripts.</p><h2>What it does</h2><ul><li>Finds what changed</li><li>Versions and tags it</li><li>Ships each app through plugins</li></ul></Prose>
      </Section>
    )}
    <Ending site={sub} title={sections.ending.title} line={sections.ending.line} links={links} />
  </Page>
) : (
  <Site {...shell} bare={story !== "masthead" && story !== "page-head"} solid={story === "page-head"}>
    {story === "hero-full" && <Hero site={sub} size="full" title={config.name} tagline={config.tagline} role={{ text: "Software engineer at", company: "Acme" }}><Socials label="Profiles" links={links} /></Hero>}
    {(story === "hero-banner" || story === "masthead") && <Hero site={sub} title="js-packages" tagline={line} />}
    {(story === "masthead" || story === "ending" || story === "page-head") && (
      <Content>
        {story === "page-head" && <PageHead title="shiplane" tagline={line} />}
        {story === "ending" && <Ending site={sub} title={sections.ending.title} line={sections.ending.line} links={links} />}
      </Content>
    )}
  </Site>
)}
