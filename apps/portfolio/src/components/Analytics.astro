---
// The question and the privacy dialog, from design parts, then the analytics itself.
import { plan } from "@arnaud-zg/analytics/plan";
import type { Settings } from "@arnaud-zg/analytics/settings";
import Ask from "@arnaud-zg/design/Ask.astro";
import Dialog from "@arnaud-zg/design/Dialog.astro";
import Pill from "@arnaud-zg/design/Pill.astro";
import config from "../../portfolio.config";

interface Props { settings: Settings }
const { settings } = Astro.props;
const { words } = config.analytics;
---
<Ask title={words.ask} text={words.askText} more={{ label: words.more, opens: "privacy" }} data-analytics-ask>
  <Pill plain data-analytics-choice="granted">{words.yes}</Pill>
  <Pill plain data-analytics-choice="refused">{words.no}</Pill>
</Ask>
<Dialog id="privacy" title={words.title}>
  <div class="prose">
    <p>{words.state}</p>
    <div class="pills">
      <Pill plain data-analytics-choice="granted" aria-pressed="false">{words.yes}</Pill>
      <Pill plain data-analytics-choice="refused" aria-pressed="false">{words.no}</Pill>
    </div>
    <h3>{words.listTitle}</h3>
    <ul>{Object.values(plan).map((e) => <li>{e.shown}</li>)}</ul>
    <h3>{words.limitsTitle}</h3>
    <p>{words.limits}</p>
    <h3>{words.whoTitle}</h3>
    <p>{words.who(config.analytics.posthogRegion)}</p>
    <p>{words.rights} <a href={config.links.find((l) => l.icon === "linkedin")?.href} target="_blank" rel="noopener noreferrer">LinkedIn</a></p>
  </div>
</Dialog>
<script type="application/json" id="analytics-settings" is:inline set:html={JSON.stringify(settings).replaceAll("<", "\\u003c")} />
<script>
  import { startAnalytics } from "@arnaud-zg/analytics";
  startAnalytics(JSON.parse(document.getElementById("analytics-settings")!.textContent!));
</script>
