---
import Page from "@arnaud-zg/design/Page.astro";
import Command from "@arnaud-zg/design/Command.astro";
import Ending from "@arnaud-zg/design/Ending.astro";
import { base, ending, hero, links, packages, repo, site } from "../site";

export const getStaticPaths = () => packages.map((p) => ({ params: { name: p.name }, props: p }));
const { name, line, problem } = Astro.props;
const docs = `${repo}/blob/main/docs/${name}`;
---
<Page site={site.id} title={`${name} · ${site.title}`} description={line} nav={site.nav} heading={name} tagline={line} transitionName={`pkg-${name}`} hero={hero.page}>
    <article class="section section--first">
      <Command label="Install" command={`pnpm add -D ${name}`} />
      <div class="prose">
        <h2>When you need it</h2>
        <p>{problem}</p>
        <h2>Documentation</h2>
        <ul>
          {[["tutorial", "Tutorial"], ["how-to", "How-to"], ["reference", "Reference"], ["explanation", "Explanation"]].map(([f, l]) => <li><a href={`${docs}/${f}.md`} target="_blank" rel="noopener noreferrer">{l}</a></li>)}
        </ul>
        <p><a href={base}>All packages</a></p>
      </div>
    </article>
    <Ending {...ending} links={links} />
</Page>
