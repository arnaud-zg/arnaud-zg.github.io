---
import Base from "../layouts/Base.astro";
import Stars from "../components/Stars.astro";
import Icon from "../components/Icon.astro";
import config from "../../portfolio.config";
import { career } from "../data/career";
import { getSideQuests } from "../data/npm";
import { getContributions } from "../data/oss";
import { getArticles, formatDate } from "../data/substack";

const { name, role, links, about, numbers: words } = config;
const quests = await getSideQuests();
const { themes, searchUrl } = await getContributions();
const articles = await getArticles();

const numbers = [
  { value: career.years, unit: "years", label: words.years },
  { value: career.longestYears, unit: "years", label: `${words.stay}, ~${career.averageYears} yrs avg` },
  { value: quests.tools, unit: "tools", label: `${quests.releases} releases, ${words.tools}` },
];
const box = (r: { x: number; y: number; w: number; h: number }, p = "") => `--${p}x:${r.x}%;--${p}y:${r.y}%;--${p}w:${r.w}%;--${p}h:${r.h}%`;
// Every link that leaves the site opens in a new tab.
const ext = { target: "_blank", rel: "noopener noreferrer" };
// Diffstat: every shown PR, bar length scaled to the largest change on the page.
const prs = themes.map((t) => ({ ...t, rows: t.projects.flatMap((p) => p.changes.map((c) => ({ repo: p.repo, ...c }))) }));
const maxLines = Math.max(1, ...prs.flatMap((t) => t.rows.map((r) => (r.added ?? 0) + (r.removed ?? 0))));
---
<Base
  title={`${name} · Software engineer`}
  description={`${name}, software engineer working on platform at Doctolib, previously senior engineer at PayFit. Open-source tools for monorepos, Expo and Vite, and contributions to rspack and Module Federation.`}
>
  <section class="hero" aria-labelledby="name">
    <div class="scene" aria-hidden="true">
      <img src="/images/bund-day-2400.webp" srcset="/images/bund-day-1200.webp 1200w, /images/bund-day-2400.webp 2400w, /images/bund-day-3840.webp 3840w" sizes="100vw" alt="" width="3840" height="2560" fetchpriority="high" />
    </div>
    <div class="sky-life" aria-hidden="true" data-loop>
      {[0, 1].map((f) => (
        <svg class="flock" style={`--f:${f}`} viewBox="0 0 120 50" width="120" height="50">
          {[[0, 20, 1], [18, 10, 0.8], [30, 26, 0.9], [46, 14, 0.7], [62, 24, 0.85], [78, 8, 0.6]].map(([x, y, sc], b) => (
            <g transform={`translate(${x} ${y}) scale(${sc})`}><path class="bird" style={`--b:${b}`} d="M0 6 Q5 0 10 6 Q15 0 20 6" /></g>
          ))}
        </svg>
      ))}
    </div>

    <div class="hero-copy">
      <h1 id="name" aria-label={name}>
        {name.split(" ").map((word, w) => (
          <span class="word" aria-hidden="true">
            {[...word].map((ch, i) => <span class="ch" style={`--i:${w * 6 + i}`}>{ch}</span>)}
          </span>
        ))}
      </h1>
      <p class="role">{role.text} <strong>{role.company}</strong></p>
      <ul class="socials" aria-label="Profiles">
        {links.map((l) => <li><a href={l.href} aria-label={l.label} {...ext}><Icon name={l.icon} size={20} /></a></li>)}
      </ul>
    </div>
    <p class="credit">Photo: <a href="https://www.pexels.com/photo/the-lujiazui-skyline-across-the-huangpu-river-4118772/" {...ext}>Jiawei Wen</a> on Pexels</p>
    <a class="scroll-cue" href="#glance" aria-label="Scroll to the numbers"><span></span></a>
  </section>

  <div class="content">
    <div class="night-sky" data-loop>
      <Stars class="night-stars" seed={12} count={180} />
    </div>
    <div class="lantern" aria-hidden="true"></div>

    <section id="glance" class="glance" aria-label="At a glance">
      <ul class="numbers">
        {numbers.map((n) => (
          <li>
            <span class="count-line"><span class="count" data-count={n.value}>{n.value}</span><span class="unit">{n.unit}</span></span>
            <span class="n-label">{n.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="about" class="section about" aria-labelledby="about-title">
      <h2 id="about-title">{about.title}</h2>
      <p class="about-lede">{about.lede}</p>
    </section>

    <section id="journey" class="section journey" aria-labelledby="journey-title">
      <header class="section-head section-head--row">
        <h2 id="journey-title">Journey</h2>
        <ul class="legend" aria-label="Company types">
          {career.types.map(([t, label]) => <li><span class={`swatch swatch--${t}`}></span>{label}</li>)}
        </ul>
      </header>

      <div class="career" role="table" aria-label="Career, newest first">
        <div class="career-head" role="row">
          <span role="columnheader">Company</span>
          <span role="columnheader">Role</span>
          <span role="columnheader">What I did</span>
          <span role="columnheader" class="axis">
            {career.ticks.map((t) => <span class="tick" style={`--l:${t.left}%`}>{t.year}</span>)}
          </span>
        </div>
        {career.rows.map((r) => (
          <div class:list={["career-row", r.type && `row--${r.type}`]} role="row">
            <span class="cr-name" role="cell">{r.name}</span>
            <span class="cr-role" role="cell">{r.role}<span class="cr-span">{r.span}</span></span>
            <span class="cr-note" role="cell">{r.note}.<span class="cr-stack">{r.stack}</span></span>
            <span class="cr-time" role="cell" aria-hidden="true">
              {career.ticks.map((t) => <span class="grid" style={`--l:${t.left}%`}></span>)}
              {r.bars.map((b) => <span class:list={["range", `row--${b.type}`, b.now && "range--now"]} style={`--l:${b.left}%;--w:${b.width}%`} title={b.name}></span>)}
              {r.marks.map((m) => <span class="mark" style={`--l:${m.left}%`}><span>{m.label}</span></span>)}
            </span>
          </div>
        ))}
      </div>
    </section>

    <section id="quests" class="section quests" aria-labelledby="quests-title">
      <header class="section-head">
        <h2 id="quests-title">Side quests</h2>
        <p class="lede">{quests.tools} tools and {quests.releases} releases on npm, built off hours. Bigger tiles shipped more releases, bright ones shipped this year. Point at a tile to enlarge it.</p>
      </header>
      <div class="treemap" data-treemap>
        {quests.groups.map((g) => (
          <section class="tm-group" data-group style={`${box(g.rect)};--n:${Math.min(g.tiles.length, 3)}`} aria-label={`${g.name}, ${g.releases} releases`}>
            <h3 class="tm-head"><span>{g.name}</span><span class="tm-n">{g.releases}</span></h3>
            <ul class="tm-tiles">
              {g.tiles.map((t) => (
                <li class:list={["tm-tile", t.recent && "tm-tile--recent"]} data-v={t.weight} style={`${box(t.rect)};${box(t.mrect, "m")}`}>
                  {t.quest ? (
                    <a class="tm-link" href={t.quest.href} {...ext}>
                      <span class="tm-name">{t.quest.name}</span>
                      <span class="tm-line">{t.quest.line}{t.quest.members > 1 && ` · +${t.quest.members - 1} plugins`}</span>
                      <span class="tm-rel">{t.releases} {t.releases === 1 ? "release" : "releases"}</span>
                    </a>
                  ) : (
                    <div class="tm-link tm-more">
                      <span class="tm-name">+{t.more!.length} more</span>
                      <span class="tm-line">{t.more!.map((q, i) => <>{i > 0 && ", "}<a class="inline" href={q.href} {...ext}>{q.name}</a></>)}</span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      {quests.earlier.length > 0 && (
        <details class="earlier">
          <summary>Earlier: {quests.earlier.length} small libraries, {quests.earlier[quests.earlier.length - 1].updated.slice(0, 4)}–{quests.earlier[0].updated.slice(0, 4)}</summary>
          <ul>{quests.earlier.map((q) => <li><a href={q.href} {...ext}>{q.name}</a> <span>{q.line}</span></li>)}</ul>
        </details>
      )}
    </section>

    <section id="writing" class="section writing" aria-labelledby="writing-title">
      <header class="section-head">
        <h2 id="writing-title">Writing</h2>
        <p class="lede">Notes on code design, on <a class="inline" href={links.find((l) => l.icon === "substack")?.href} {...ext}>Substack</a>.</p>
      </header>
      <ul class="articles">
        {articles.map((a, i) => (
          <li style={`--a:${i}`}>
            <a class="article" href={a.url} {...ext}>
              <span class="cover">{a.image && <img src={a.image} alt="" loading="lazy" decoding="async" width="720" height="480" />}</span>
              <time datetime={a.date}>{formatDate(a.date)}</time>
              <span class="a-title">{a.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="open-source" class="section oss" aria-labelledby="oss-title">
      <header class="section-head">
        <h2 id="oss-title">Open source</h2>
        <p class="lede">Fixes merged upstream, in tools other teams rely on.</p>
      </header>
      <div class="diffstat">
        {prs.map((t) => (
          <section class="ds-theme" aria-label={t.name}>
            <h3 class="theme-head">{t.name}<span>{t.years}</span></h3>
            <ul>
              {t.rows.map((r) => {
                const add = ((r.added ?? 0) / maxLines) * 100, del = ((r.removed ?? 0) / maxLines) * 100;
                return (
                  <li>
                    <a class="ds-row" href={r.url} {...ext}>
                      <span class="ds-repo"><span class="owner">{r.repo.split("/")[0]}/</span>{r.repo.split("/")[1]}</span>
                      <span class="kind">{r.kind}</span>
                      <span class="ds-title">{r.title}</span>
                      <span class="diff">{r.added !== undefined && <><b>+{r.added}</b> <i>−{r.removed}</i></>}</span>
                      <span class="ds-bar" aria-hidden="true"><b style={`--w:${add}%`}></b><i style={`--w:${del}%`}></i></span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
        <p class="ds-key"><b></b> lines added <i></i> lines removed · bar length is the size of the change</p>
      </div>
      <a class="all-prs" href={searchUrl} {...ext}>Every merged pull request on GitHub <Icon name="arrow" size={18} /></a>
    </section>

    <footer id="contact" class="ending">
      <h2 class="tbc">To be continued</h2>
      <ul class="end-links">
        {links.map((l) => <li><a href={l.href} {...ext}><Icon name={l.icon} size={17} /> {l.label}</a></li>)}
      </ul>
    </footer>
  </div>
</Base>

<script>
  // Side quests: pointing at a tile grows it to a readable size and the rest of the
  // treemap shrinks around it, animated by CSS transitions on the box variables.
  import { squarify, TREEMAP_BOX as BOX } from "../lib/treemap";

  const map = document.querySelector<HTMLElement>("[data-treemap]");
  const wide = matchMedia("(min-width: 961px) and (hover: hover)");
  if (map) {
    const groups = [...map.querySelectorAll<HTMLElement>("[data-group]")].map((el) => ({
      el,
      tiles: [...el.querySelectorAll<HTMLElement>("[data-v]")].map((t) => ({ el: t, v: Number(t.dataset.v) })),
    }));
    const total = groups.reduce((n, g) => n + g.tiles.reduce((m, t) => m + t.v, 0), 0);
    const set = (el: HTMLElement, r: { x: number; y: number; w: number; h: number }) => {
      for (const [k, v] of Object.entries(r)) el.style.setProperty(`--${k}`, `${v}%`);
    };

    // Lay out again with one tile weighted up: twice its size, and at least 13% of the map.
    const layout = (focus?: HTMLElement) => {
      const values = groups.map((g) => g.tiles.map((t) => (t.el === focus ? Math.max(t.v * 2, total * 0.13) : t.v)));
      const outer = squarify(values.map((vs) => vs.reduce((a, b) => a + b, 0)), BOX.w, BOX.h, true);
      groups.forEach((g, gi) => {
        set(g.el, outer[gi]);
        const inner = squarify(values[gi], (outer[gi].w / 100) * BOX.w, (outer[gi].h / 100) * BOX.h, true);
        g.tiles.forEach((t, ti) => set(t.el, inner[ti]));
        g.el.classList.toggle("is-focus", g.tiles.some((t) => t.el === focus));
      });
      groups.forEach((g) => g.tiles.forEach((t) => t.el.classList.toggle("is-focus", t.el === focus)));
    };
    // Hover intent: act only when the pointer rests on a tile. Sweeping across the map
    // on the way somewhere else changes nothing; leaving restores after a short grace.
    const REST_MS = 380, LEAVE_MS = 260;
    let timer = 0, focused: HTMLElement | undefined;
    const schedule = (target: HTMLElement | undefined, delay: number) => {
      clearTimeout(timer);
      if (target === focused) return;
      timer = window.setTimeout(() => { focused = target; layout(target); }, delay);
    };
    for (const g of groups) for (const t of g.tiles) {
      t.el.addEventListener("pointerenter", () => wide.matches && schedule(t.el, REST_MS));
      t.el.addEventListener("focusin", () => { if (wide.matches) { clearTimeout(timer); focused = t.el; layout(t.el); } });
    }
    map.addEventListener("pointerleave", () => wide.matches && schedule(undefined, LEAVE_MS));
    map.addEventListener("focusout", (e) => { if (wide.matches && !map.contains(e.relatedTarget as Node)) schedule(undefined, 0); });
  }
</script>
