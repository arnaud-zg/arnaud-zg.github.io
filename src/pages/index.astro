---
import Base from "../layouts/Base.astro";
import Stars from "../components/Stars.astro";
import Icon from "../components/Icon.astro";
import { skills, stations, links } from "../data/profile";
import { getNpmStats, formatMonth } from "../data/npm";
import { getContributions, formatStars } from "../data/oss";
import { getArticles, formatDate } from "../data/substack";

const { totalPrs, projects, highlights, all } = await getContributions();
const shown = highlights.slice(0, 5);
const npm = await getNpmStats();
const quests = npm.quests.slice(0, 6);
const articles = await getArticles();
const years = new Date().getFullYear() - 2013;
const numbers = [
  { value: years, label: "years shipping software" },
  { value: npm.tools, label: "open-source tools published" },
  { value: totalPrs, label: "merged open-source PRs" },
  { value: articles.length, label: "articles written" },
];
const name = "Arnaud Zheng";
// Every link that leaves the site opens in a new tab.
const ext = { target: "_blank", rel: "noopener noreferrer" };
---
<Base
  title="Arnaud Zheng · Software engineer"
  description="Arnaud Zheng, software engineer working on platform at Doctolib, previously senior engineer at PayFit. Open-source tools for monorepos, Expo and Vite, and contributions to rspack and Module Federation."
>
  <section class="hero" aria-labelledby="name">
    <div class="scene" aria-hidden="true">
      <img src="/images/bund-day-2400.webp" srcset="/images/bund-day-1200.webp 1200w, /images/bund-day-2400.webp 2400w, /images/bund-day-3840.webp 3840w" sizes="100vw" alt="" width="3840" height="2560" fetchpriority="high" />
    </div>
    <div class="sky-life" aria-hidden="true" data-loop>
      {[0, 1].map((f) => (
        <svg class="flock" style={`--f:${f}`} viewBox="0 0 120 50" width="120" height="50">
          {[[0, 20, 1], [18, 10, 0.8], [30, 26, 0.9], [46, 14, 0.7], [62, 24, 0.85], [78, 8, 0.6]].map(([x, y, sc], b) => (
            <g transform={`translate(${x} ${y}) scale(${sc})`}><path class="bird" style={`--b:${b}`} d="M0 6 Q5 0 10 6 Q15 0 20 6" /></g>
          ))}
        </svg>
      ))}
    </div>

    <div class="hero-copy">
      <h1 id="name" aria-label={name}>
        {name.split(" ").map((word, w) => (
          <span class="word" aria-hidden="true">
            {[...word].map((ch, i) => <span class="ch" style={`--i:${w * 6 + i}`}>{ch}</span>)}
          </span>
        ))}
      </h1>
      <p class="role">Software engineer, Platform at <strong>Doctolib</strong></p>
      <ul class="socials" aria-label="Profiles">
        {links.map((l) => <li><a href={l.href} aria-label={l.label} {...ext}><Icon name={l.icon} size={20} /></a></li>)}
      </ul>
    </div>
    <p class="credit">Photo: <a href="https://www.pexels.com/photo/the-lujiazui-skyline-across-the-huangpu-river-4118772/" {...ext}>Jiawei Wen</a> on Pexels</p>
    <a class="scroll-cue" href="#glance" aria-label="Scroll to the numbers"><span></span></a>
  </section>

  <div class="content">
    <div class="night-sky" data-loop>
      <Stars class="night-stars" seed={12} count={180} />
    </div>
    <div class="lantern" aria-hidden="true"></div>

    <section id="glance" class="glance" aria-label="At a glance">
      <ul class="numbers">
        {numbers.map((n) => (
          <li><span class="count" data-count={n.value}>{n.value}</span><span class="n-label">{n.label}</span></li>
        ))}
      </ul>
    </section>

    <section id="about" class="section about" aria-labelledby="about-title">
      <header class="section-head">
        <h2 id="about-title">Hi, I'm Arnaud.</h2>
        <p class="lede">I build the platforms and tools that help engineers <em>ship faster, with confidence</em>. Over a decade across startups, scale-ups and product teams.</p>
      </header>
      <dl class="skills">
        {skills.map((g) => (
          <div class="skill-group">
            <dt>{g.group}</dt>
            <dd><ul>{g.items.map((i) => <li>{i}</li>)}</ul></dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="journey" class="section journey" aria-labelledby="journey-title">
      <header class="section-head">
        <h2 id="journey-title">Journey</h2>
        <p class="lede">From agencies in Paris and Shanghai to platform work at Doctolib.</p>
      </header>
      <ol class="line">
        {stations.map((st, i) => (
          <li class:list={["station", st.now && "station--now"]} style={`--s:${i}`}>
            <span class="stop" aria-hidden="true"></span>
            <p class="year">{st.year}{st.now && <span class="now">now</span>}</p>
            <h3>{st.name}</h3>
            <p class="st-role">{st.role}</p>
            <p class="st-note">{st.note}</p>
          </li>
        ))}
      </ol>
      <p class="footnote">Graduated from Epitech and Tongji University.</p>
    </section>

    <section id="quests" class="section quests" aria-labelledby="quests-title">
      <header class="section-head">
        <h2 id="quests-title">Side quests</h2>
        <p class="lede">{npm.tools} open-source tools on npm, most recently released first.</p>
      </header>
      <ul class="rows">
        {quests.map((q) => (
          <li>
            <a class="row row--quest" href={q.href} {...ext}>
              <span class="row-name">{q.name}{q.members > 1 && <span class="family">+{q.members - 1} {q.members === 2 ? "plugin" : "plugins"}</span>}</span>
              <span class="row-line">{q.line}</span>
              <span class="row-meta">{q.version ? `v${q.version}` : formatMonth(q.updated)}</span>
              <Icon name="arrow" />
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="writing" class="section writing" aria-labelledby="writing-title">
      <header class="section-head">
        <h2 id="writing-title">Writing</h2>
        <p class="lede">Notes on code design, on <a class="inline" href="https://arnaudzg.substack.com" {...ext}>Substack</a>.</p>
      </header>
      <ul class="articles">
        {articles.map((a, i) => (
          <li style={`--a:${i}`}>
            <a class="article" href={a.url} {...ext}>
              <span class="cover">{a.image && <img src={a.image} alt="" loading="lazy" decoding="async" width="720" height="480" />}</span>
              <time datetime={a.date}>{formatDate(a.date)}</time>
              <span class="a-title">{a.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="open-source" class="section oss" aria-labelledby="oss-title">
      <header class="section-head">
        <h2 id="oss-title">Open source</h2>
        <p class="lede">What I changed in tools other teams rely on, most substantial first.</p>
      </header>
      <ol class="mosaic">
        {shown.map((p, i) => (
          <li class:list={["tile", `tile--${i + 1}`]} style={`--t:${i}`}>
            <a class="tile-repo" href={`https://github.com/${p.repo}`} {...ext}>
              <span class="owner">{p.repo.split("/")[0]}/</span>
              <span class="tile-name">{p.repo.split("/")[1]}</span>
            </a>
            <p class="tile-about">{p.about}</p>
            <ul class="changes">
              {p.changes.slice(0, 2).map((c) => (
                <li>
                  <a class="change" href={c.url} {...ext}>
                    <span class="kind">{c.kind}</span>
                    <span class="change-title">{c.title}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="tile-meta"><span><Icon name="star" size={12} /> {formatStars(p.stars)} stars</span><span>{Math.max(...p.changes.map((c) => c.year))}</span></p>
          </li>
        ))}
      </ol>
      <button class="all-prs" type="button" data-open-dialog="all-prs" aria-haspopup="dialog">See all {totalPrs} pull requests across {projects} projects <Icon name="arrow" size={18} /></button>

      <dialog id="all-prs" class="prs-dialog" aria-labelledby="prs-title">
        <header class="dialog-head">
          <div>
            <h2 id="prs-title">All merged pull requests</h2>
            <p class="lede">{totalPrs} across {projects} projects, none of them mine.</p>
          </div>
          <button class="dialog-close" type="button" data-close-dialog aria-label="Close">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </button>
        </header>
        <ol class="pr-groups">
          {all.map((g) => (
            <li class="pr-group">
              <a class="pr-repo" href={`https://github.com/${g.repo}`} {...ext}><span class="owner">{g.repo.split("/")[0]}/</span>{g.repo.split("/")[1]}<span class="pr-count">{g.prs.length} {g.prs.length === 1 ? "PR" : "PRs"}</span></a>
              <ul>
                {g.prs.map((pr) => (
                  <li><a class="pr-item" href={pr.url} {...ext}><span class="kind">{pr.kind}</span><span class="pr-title">{pr.title}</span><span class="pr-year">{pr.year}</span></a></li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </dialog>
    </section>

    <footer id="contact" class="ending">
      <h2 class="tbc">To be continued</h2>
      <ul class="end-links">
        {links.map((l) => <li><a href={l.href} {...ext}><Icon name={l.icon} size={17} /> {l.label}</a></li>)}
      </ul>
    </footer>
  </div>
</Base>
