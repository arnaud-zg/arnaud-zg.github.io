---
import Base from "../layouts/Base.astro";
import Stars from "../components/Stars.astro";
import Icon from "../components/Icon.astro";
import config from "../../portfolio.config";
import { career, formatSpan } from "../data/career";
import { getSideQuests } from "../data/npm";
import { getContributions } from "../data/oss";
import { getArticles, formatDate } from "../data/substack";
import { constellations, SKY } from "../lib/constellation";

const { name, role, links, about, numbers: words } = config;
const quests = await getSideQuests();
const { themes, searchUrl } = await getContributions();
const articles = await getArticles();

const numbers = [
  { value: career.years, unit: "years", label: words.years },
  { value: career.longestYears, unit: "years", label: `${words.stay}, ~${career.averageYears} yrs avg` },
  { value: quests.tools, unit: "tools", label: `${quests.releases} releases, ${words.tools}` },
];
const current = career.segments.find((s) => s.now) ?? career.segments[career.segments.length - 1];
const noteOf = (s: (typeof career.segments)[number]) => `${s.name} · ${s.role} · ${formatSpan(s.months)}. ${s.note}.`;
// Narrow segments label below the bar; every other one drops a line so neighbours don't collide.
const stagger = new Set(career.segments.map((s, i) => (s.width < 7 ? i : -1)).filter((i) => i >= 0).filter((_, k) => k % 2 === 1));
const longest = Math.max(...career.segments.map((s) => s.months));
const box = (r: { x: number; y: number; w: number; h: number }, p = "") => `--${p}x:${r.x}%;--${p}y:${r.y}%;--${p}w:${r.w}%;--${p}h:${r.h}%`;
// Every link that leaves the site opens in a new tab.
const ext = { target: "_blank", rel: "noopener noreferrer" };
const sky = constellations(themes);
const projectOf = new Map(themes.flatMap((t) => t.projects.map((p) => [p.repo, p])));
const lineCount = (n: number) => `${n} ${n === 1 ? "line" : "lines"}`;
const firstStar = sky[0]?.stars[0]?.id;
---
<Base
  title={`${name} · Software engineer`}
  description={`${name}, software engineer working on platform at Doctolib, previously senior engineer at PayFit. Open-source tools for monorepos, Expo and Vite, and contributions to rspack and Module Federation.`}
>
  <section class="hero" aria-labelledby="name">
    <div class="scene" aria-hidden="true">
      <img src="/images/bund-day-2400.webp" srcset="/images/bund-day-1200.webp 1200w, /images/bund-day-2400.webp 2400w, /images/bund-day-3840.webp 3840w" sizes="100vw" alt="" width="3840" height="2560" fetchpriority="high" />
    </div>
    <div class="sky-life" aria-hidden="true" data-loop>
      {[0, 1].map((f) => (
        <svg class="flock" style={`--f:${f}`} viewBox="0 0 120 50" width="120" height="50">
          {[[0, 20, 1], [18, 10, 0.8], [30, 26, 0.9], [46, 14, 0.7], [62, 24, 0.85], [78, 8, 0.6]].map(([x, y, sc], b) => (
            <g transform={`translate(${x} ${y}) scale(${sc})`}><path class="bird" style={`--b:${b}`} d="M0 6 Q5 0 10 6 Q15 0 20 6" /></g>
          ))}
        </svg>
      ))}
    </div>

    <div class="hero-copy">
      <h1 id="name" aria-label={name}>
        {name.split(" ").map((word, w) => (
          <span class="word" aria-hidden="true">
            {[...word].map((ch, i) => <span class="ch" style={`--i:${w * 6 + i}`}>{ch}</span>)}
          </span>
        ))}
      </h1>
      <p class="role">{role.text} <strong>{role.company}</strong></p>
      <ul class="socials" aria-label="Profiles">
        {links.map((l) => <li><a href={l.href} aria-label={l.label} {...ext}><Icon name={l.icon} size={20} /></a></li>)}
      </ul>
    </div>
    <p class="credit">Photo: <a href="https://www.pexels.com/photo/the-lujiazui-skyline-across-the-huangpu-river-4118772/" {...ext}>Jiawei Wen</a> on Pexels</p>
    <a class="scroll-cue" href="#glance" aria-label="Scroll to the numbers"><span></span></a>
  </section>

  <div class="content">
    <div class="night-sky" data-loop>
      <Stars class="night-stars" seed={12} count={180} />
    </div>
    <div class="lantern" aria-hidden="true"></div>

    <section id="glance" class="glance" aria-label="At a glance">
      <ul class="numbers">
        {numbers.map((n) => (
          <li>
            <span class="count-line"><span class="count" data-count={n.value}>{n.value}</span><span class="unit">{n.unit}</span></span>
            <span class="n-label">{n.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="about" class="section about" aria-labelledby="about-title">
      <h2 id="about-title">{about.title}</h2>
      <p class="about-lede">{about.lede}</p>
    </section>

    <section id="journey" class="section journey" aria-labelledby="journey-title">
      <header class="section-head section-head--row">
        <h2 id="journey-title">Journey</h2>
        <ul class="legend" aria-label="Company types">
          {career.types.map(([t, label]) => <li><span class={`swatch swatch--${t}`}></span>{label}</li>)}
        </ul>
      </header>

      <div class="career" data-career>
        <div class="skyline">
          <ol class="levels" aria-hidden="true">
            {career.levels.map((l) => <li style={`--h:${l.height}%`}><span>{l.name}</span></li>)}
          </ol>
          <ol class="segments">
            {career.segments.map((s, i) => (
              <li class:list={["segment", `segment--${s.type}`, s.now && "segment--now", s.width < 7 && "segment--narrow", stagger.has(i) && "segment--stagger"]} style={`--l:${s.left}%;--w:${s.width}%;--top:${s.top}%;--i:${i}`}>
                <button type="button" class="seg" data-note={noteOf(s)} aria-label={noteOf(s)} aria-pressed={s.now ? "true" : "false"}>
                  {s.parts.map((p) => (
                    <span class="part" style={`--pl:${p.left}%;--pw:${p.width}%;--ph:${p.height}%`}>{p.label && <span class="part-mark">{p.label}</span>}</span>
                  ))}
                </button>
                <span class="seg-name" aria-hidden="true">{s.name}</span>
              </li>
            ))}
          </ol>
        </div>
        <ol class="ticks" aria-hidden="true">
          {career.ticks.map((t) => <li style={`--l:${t.left}%`}>{t.year}</li>)}
        </ol>
        {career.schoolBand && (
          <p class="school" style={`--l:${career.schoolBand.left}%;--w:${career.schoolBand.width}%`}><span>{career.schoolBand.label}</span></p>
        )}
        <ol class="lanes" aria-label="Stack over time">
          {career.lanes.map((l) => (
            <li style={`--l:${l.left}%;--w:${l.width}%`}><span class="lane-label">{l.label}</span></li>
          ))}
        </ol>
        <p class="career-note" aria-live="polite" data-career-note>{noteOf(current)}</p>
      </div>

      <ol class="career-list">
        {[...career.segments].reverse().map((s) => (
          <li class={`cl cl--${s.type}`} style={`--len:${(s.months / longest) * 100}%`}>
            <p class="cl-head"><span class="cl-name">{s.name}</span><span class="cl-span">{s.start.slice(0, 4)} · {formatSpan(s.months)}</span></p>
            <span class="cl-bar" aria-hidden="true"></span>
            <p class="cl-note">{s.role}. {s.note}.</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="quests" class="section quests" aria-labelledby="quests-title">
      <header class="section-head">
        <h2 id="quests-title">Side quests</h2>
        <p class="lede">{quests.tools} tools and {quests.releases} releases on npm, built off hours. Area is releases; bright ones shipped this year.</p>
      </header>
      <div class="treemap">
        {quests.groups.map((g) => (
          <section class="tm-group" style={`${box(g.rect)};--n:${Math.min(g.tiles.length, 3)}`} aria-label={`${g.name}, ${g.releases} releases`}>
            <h3 class="tm-head"><span>{g.name}</span><span class="tm-n">{g.releases}</span></h3>
            <ul class="tm-tiles">
              {g.tiles.map((t) => (
                <li class:list={["tm-tile", t.recent && "tm-tile--recent"]} style={`${box(t.rect)};${box(t.mrect, "m")}`}>
                  {t.quest ? (
                    <a class="tm-link" href={t.quest.href} {...ext}>
                      <span class="tm-name">{t.quest.name}</span>
                      <span class="tm-line">{t.quest.line}{t.quest.members > 1 && ` · +${t.quest.members - 1} plugins`}</span>
                      <span class="tm-rel">{t.releases} {t.releases === 1 ? "release" : "releases"}</span>
                    </a>
                  ) : (
                    <div class="tm-link tm-more">
                      <span class="tm-name">+{t.more!.length} more</span>
                      <span class="tm-line">{t.more!.map((q, i) => <>{i > 0 && ", "}<a class="inline" href={q.href} {...ext}>{q.name}</a></>)}</span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      {quests.earlier.length > 0 && (
        <details class="earlier">
          <summary>Earlier: {quests.earlier.length} small libraries, {quests.earlier[quests.earlier.length - 1].updated.slice(0, 4)}–{quests.earlier[0].updated.slice(0, 4)}</summary>
          <ul>{quests.earlier.map((q) => <li><a href={q.href} {...ext}>{q.name}</a> <span>{q.line}</span></li>)}</ul>
        </details>
      )}
    </section>

    <section id="writing" class="section writing" aria-labelledby="writing-title">
      <header class="section-head">
        <h2 id="writing-title">Writing</h2>
        <p class="lede">Notes on code design, on <a class="inline" href={links.find((l) => l.icon === "substack")?.href} {...ext}>Substack</a>.</p>
      </header>
      <ul class="articles">
        {articles.map((a, i) => (
          <li style={`--a:${i}`}>
            <a class="article" href={a.url} {...ext}>
              <span class="cover">{a.image && <img src={a.image} alt="" loading="lazy" decoding="async" width="720" height="480" />}</span>
              <time datetime={a.date}>{formatDate(a.date)}</time>
              <span class="a-title">{a.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="open-source" class="section oss" aria-labelledby="oss-title">
      <header class="section-head">
        <h2 id="oss-title">Open source</h2>
        <p class="lede">Fixes merged upstream, in tools other teams rely on.</p>
      </header>
      <div class="sky" data-sky>
        <svg class="sky-map" viewBox={`0 0 ${SKY.w} ${SKY.h}`} role="group" aria-label="Projects I contributed to, one constellation per theme">
          <defs>
            <radialGradient id="star-glow"><stop offset="0" stop-color="currentColor" stop-opacity="0.55" /><stop offset="1" stop-color="currentColor" stop-opacity="0" /></radialGradient>
          </defs>
          {sky.map((c) => (
            <g class="cluster">
              <text class="cluster-name" x={c.x} y="48" text-anchor="middle">{c.name}</text>
              {c.stars.slice(1).map((st, j) => <line class="link" x1={c.stars[j].x} y1={c.stars[j].y} x2={st.x} y2={st.y} />)}
              {c.stars.map((st, j) => {
                const p = projectOf.get(st.id)!;
                const lx = st.side === "left" ? st.x - st.r - 12 : st.x + st.r + 12;
                return (
                  <a class="star" href={`https://github.com/${p.repo}`} data-star={st.id} aria-label={`${p.repo}: ${p.changes.length} merged ${p.changes.length === 1 ? "change" : "changes"}, ${lineCount(p.lines)}`} style={`--d:${j}`} {...ext}>
                    <circle class="halo" cx={st.x} cy={st.y} r={st.r * 3.2} fill="url(#star-glow)" />
                    <circle class="core" cx={st.x} cy={st.y} r={st.r} />
                    <text class="star-name" x={lx} y={st.y - 2} text-anchor={st.side === "left" ? "end" : "start"}>{p.repo.split("/")[1]}</text>
                    <text class="star-lines" x={lx} y={st.y + 16} text-anchor={st.side === "left" ? "end" : "start"}>{p.changes.map((ch) => ch.kind).join(" · ")} · {lineCount(p.lines)}</text>
                  </a>
                );
              })}
            </g>
          ))}
        </svg>
        <div class="sky-detail" aria-live="polite">
          {themes.flatMap((t) => t.projects).map((p) => (
            <div class="star-card" data-card={p.repo} hidden={p.repo !== firstStar}>
              <p class="star-card-head"><span class="owner">{p.repo.split("/")[0]}/</span>{p.repo.split("/")[1]}<span class="star-card-about">{p.about}</span></p>
              <ul class="cl-changes">
                {p.changes.map((c) => (
                  <li><a class="cl-change" href={c.url} {...ext}><span class="kind">{c.kind}</span><span class="cl-title">{c.title}</span><span class="diff">{c.added !== undefined && <><b>+{c.added}</b> <i>−{c.removed}</i></>}</span></a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div class="changelog" data-mobile-only>
        {themes.map((t) => (
          <section class="theme" aria-label={t.name}>
            <h3 class="theme-head">{t.name}<span>{t.years}</span></h3>
            <ul class="theme-projects">
              {t.projects.map((p) => (
                <li>
                  <a class="cl-repo" href={`https://github.com/${p.repo}`} {...ext}><span class="owner">{p.repo.split("/")[0]}/</span>{p.repo.split("/")[1]}</a>
                  <ul class="cl-changes">
                    {p.changes.map((c) => (
                      <li><a class="cl-change" href={c.url} {...ext}><span class="kind">{c.kind}</span><span class="cl-title">{c.title}</span><Icon name="arrow" size={14} /></a></li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <a class="all-prs" href={searchUrl} {...ext}>Every merged pull request on GitHub <Icon name="arrow" size={18} /></a>
    </section>

    <footer id="contact" class="ending">
      <h2 class="tbc">To be continued</h2>
      <ul class="end-links">
        {links.map((l) => <li><a href={l.href} {...ext}><Icon name={l.icon} size={17} /> {l.label}</a></li>)}
      </ul>
    </footer>
  </div>
</Base>

<script>
  // Journey: hovering, focusing or tapping a segment shows its line under the chart.
  const note = document.querySelector<HTMLElement>("[data-career-note]");
  const segs = document.querySelectorAll<HTMLButtonElement>("[data-career] .seg");
  const show = (btn: HTMLButtonElement) => {
    if (!note) return;
    note.textContent = btn.dataset.note ?? "";
    segs.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
  };
  // Open source: pointing at a star shows its pull requests under the sky.
  const cards = document.querySelectorAll<HTMLElement>("[data-card]");
  document.querySelectorAll<SVGAElement>("[data-star]").forEach((star) => {
    const pick = () => {
      cards.forEach((c) => { c.hidden = c.dataset.card !== star.dataset.star; });
      document.querySelectorAll("[data-star]").forEach((s) => s.classList.toggle("is-active", s === star));
    };
    star.addEventListener("pointerenter", pick);
    star.addEventListener("focus", pick);
  });
  document.querySelector(`[data-star]`)?.classList.add("is-active");

  segs.forEach((btn) => {
    btn.addEventListener("pointerenter", () => show(btn));
    btn.addEventListener("focus", () => show(btn));
    btn.addEventListener("click", () => show(btn));
  });
</script>
