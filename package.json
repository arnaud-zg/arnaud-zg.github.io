{
  "name": "arnaud-zg-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check && astro build",
    "preview": "astro preview",
    "preview:sites": "PREVIEW_SITES=1 astro build --outDir .preview && pnpm --filter js-packages-site preview:build && astro preview --outDir .preview --port 4330",
    "check": "node scripts/check-design.mjs",
    "site:deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@arnaud-zg/design": "workspace:*",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.13"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
